{"command": "cat > /testbed/tests/test_transactional.py << 'PYEOF'\n\"\"\"\nFocused tests for TransactionalTinyDB.\n\"\"\"\n\nimport copy\nimport pytest\nfrom tinydb import TransactionalTinyDB, Query, TinyDB\nfrom tinydb.storages import MemoryStorage\n\n\nclass CountingStorage(MemoryStorage):\n    \"\"\"Storage that counts write calls.\"\"\"\n    last = None\n\n    def __init__(self):\n        super().__init__()\n        self.writes = []\n        CountingStorage.last = self\n\n    def write(self, data):\n        self.writes.append(copy.deepcopy(data))\n        super().write(data)\n\n\nclass TestTransactionalTinyDBBasic:\n    \"\"\"Test basic TransactionalTinyDB functionality.\"\"\"\n\n    def test_import(self):\n        \"\"\"R01: TransactionalTinyDB can be imported.\"\"\"\n        from tinydb import TransactionalTinyDB\n        assert TransactionalTinyDB is not None\n\n    def test_constructor_same_as_tinydb(self):\n        \"\"\"R01: TransactionalTinyDB accepts same constructor args as TinyDB.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        assert db is not None\n        db.close()\n\n    def test_nontransactional_operations_work(self):\n        \"\"\"R01: Non-transactional operations work normally.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n        assert len(db) == 1\n        assert db.search(Query().value == 1)\n        db.close()\n\n    def test_named_tables_work(self):\n        \"\"\"R01: Named/default tables work normally.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        tbl = db.table('my_table')\n        tbl.insert({'value': 1})\n        assert len(tbl) == 1\n        db.close()\n\n\nclass TestTransactionCommit:\n    \"\"\"Test transaction commit behavior.\"\"\"\n\n    def test_commit_writes_once(self):\n        \"\"\"R03: Successful outer exit writes exactly once.\"\"\"\n        db = TransactionalTinyDB(storage=CountingStorage)\n        backend = CountingStorage.last\n        backend.writes.clear()\n\n        with db.transaction():\n            db.insert({'value': 1})\n\n        assert len(backend.writes) == 1\n        db.close()\n\n    def test_commit_multiple_tables(self):\n        \"\"\"R03: Multiple tables written in single write.\"\"\"\n        db = TransactionalTinyDB(storage=CountingStorage)\n        backend = CountingStorage.last\n        backend.writes.clear()\n\n        with db.transaction():\n            db.insert({'table': 'default'})\n            tbl = db.table('other')\n            tbl.insert({'table': 'other'})\n\n        assert len(backend.writes) == 1\n        assert len(db) == 1\n        assert len(tbl) == 1\n        db.close()\n\n    def test_context_manager_yields_db(self):\n        \"\"\"R02: transaction() yields the same db.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        with db.transaction() as current:\n            assert current is db\n        db.close()\n\n    def test_mutations_visible_within_transaction(self):\n        \"\"\"R02: Mutations before entry are visible within transaction.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with db.transaction():\n            # Data inserted before transaction should be visible\n            assert db.search(Query().value == 1)\n            db.insert({'value': 2})\n            assert db.search(Query().value == 2)\n\n        assert db.search(Query().value == 1)\n        assert db.search(Query().value == 2)\n        db.close()\n\n\nclass TestTransactionRollback:\n    \"\"\"Test transaction rollback behavior.\"\"\"\n\n    def test_exception_propagates(self):\n        \"\"\"R04: Exceptions propagate out of transaction.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                raise ValueError('test')\n\n        db.close()\n\n    def test_baseexception_propagates(self):\n        \"\"\"R04: BaseException subclasses propagate out.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(SystemExit):\n            with db.transaction():\n                raise SystemExit('test')\n\n        db.close()\n\n    def test_no_backend_writes_on_rollback(self):\n        \"\"\"R04: Zero backend writes on rollback.\"\"\"\n        db = TransactionalTinyDB(storage=CountingStorage)\n        backend = CountingStorage.last\n        backend.writes.clear()\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'value': 1})\n                raise ValueError('rollback')\n\n        assert backend.writes == []\n        db.close()\n\n    def test_data_restored_after_rollback(self):\n        \"\"\"R05: Rollback restores pre-transaction data.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.update({'value': 2})\n                raise ValueError('rollback')\n\n        assert db.search(Query().value == 1)\n        assert not db.search(Query().value == 2)\n        db.close()\n\n    def test_nested_mutable_values_restored(self):\n        \"\"\"R05: Nested mutable values restored after rollback.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1, 'nested': [1, 2]})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.update(lambda doc: doc['nested'].append(3))\n                raise ValueError('rollback')\n\n        assert db.search(Query().value == 1)[0]['nested'] == [1, 2]\n        db.close()\n\n    def test_query_cache_cleared_after_rollback(self):\n        \"\"\"R05: Query caches don't return discarded work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'value': 2})\n                assert db.search(Query().value == 2)  # Populate cache\n                raise ValueError('rollback')\n\n        # Cache should be cleared, search should not find value==2\n        assert not db.search(Query().value == 2)\n        db.close()\n\n    def test_later_transaction_works(self):\n        \"\"\"R04: A later transaction still works after rollback.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'value': 1})\n                raise ValueError('rollback')\n\n        # Later transaction should work\n        with db.transaction():\n            db.insert({'value': 2})\n\n        assert db.search(Query().value == 2)\n        db.close()\n\n\nclass TestTransactionIDManagement:\n    \"\"\"Test ID management during transactions.\"\"\"\n\n    def test_no_id_collisions_after_rollback(self):\n        \"\"\"R06: Existing handles can insert without ID collisions.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'value': 2})  # Gets ID 2\n                raise ValueError('rollback')\n\n        # New insert should not reuse ID 2\n        new_id = db.insert({'value': 3})\n        assert new_id != 2\n        db.close()\n\n    def test_insert_multiple_ids_after_rollback(self):\n        \"\"\"R06: Multiple inserts after rollback have unique IDs.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'value': 2})  # ID 2\n                db.insert({'value': 3})  # ID 3\n                raise ValueError('rollback')\n\n        # New inserts should have IDs > 3\n        id1 = db.insert({'value': 4})\n        id2 = db.insert({'value': 5})\n        assert id1 > 3 and id2 > 3\n        assert id1 != id2\n        db.close()\n\n\nclass TestTransactionNesting:\n    \"\"\"Test transaction nesting behavior (R09 - supersedes R07).\"\"\"\n\n    def test_nested_transactions_create_savepoints(self):\n        \"\"\"R09: Nested transaction() creates independent savepoints.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with db.transaction():\n            db.insert({'a': 1})\n            with db.transaction():\n                db.insert({'b': 2})\n                # Both should be visible within nested transaction\n                assert db.search(Query().a == 1)\n                assert db.search(Query().b == 2)\n            # After inner commit, both should still be visible\n            assert db.search(Query().a == 1)\n            assert db.search(Query().b == 2)\n\n        assert db.search(Query().a == 1)\n        assert db.search(Query().b == 2)\n        db.close()\n\n    def test_three_level_nesting(self):\n        \"\"\"R09: At least three levels of nesting work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with db.transaction():\n            db.insert({'level': 0})\n            with db.transaction():\n                db.insert({'level': 1})\n                with db.transaction():\n                    db.insert({'level': 2})\n                    with db.transaction():\n                        db.insert({'level': 3})\n                        assert len(db) == 4\n\n        assert len(db) == 4\n        db.close()\n\n    def test_inner_commit_merges_without_write(self):\n        \"\"\"R10: Successful inner exit merges into parent without writing.\"\"\"\n        db = TransactionalTinyDB(storage=CountingStorage)\n        backend = CountingStorage.last\n        backend.writes.clear()\n\n        with db.transaction():\n            db.insert({'a': 1})\n            with db.transaction():\n                db.insert({'b': 2})\n            # No write should have occurred for inner commit\n            assert backend.writes == []\n            assert db.search(Query().b == 2)\n\n        # Only one write at the end\n        assert len(backend.writes) == 1\n        db.close()\n\n    def test_inner_rollback_only_affects_own_changes(self):\n        \"\"\"R11: Failed inner scope rolls back only its own changes.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with db.transaction():\n            db.insert({'a': 1})\n            with pytest.raises(ValueError):\n                with db.transaction():\n                    db.insert({'b': 2})\n                    raise ValueError('inner')\n            # 'a' should still be visible, 'b' should not\n            assert db.search(Query().a == 1)\n            assert not db.search(Query().b == 2)\n            # Outer work continues\n            db.insert({'c': 3})\n\n        assert db.search(Query().a == 1)\n        assert not db.search(Query().b == 2)\n        assert db.search(Query().c == 3)\n        db.close()\n\n    def test_outer_rollback_discards_inner_scopes(self):\n        \"\"\"R12: Outer failure discards even successfully completed inner scopes.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert({'a': 1})\n                with db.transaction():\n                    db.insert({'b': 2})\n                # Inner commit succeeded, but outer will fail\n                raise ValueError('outer')\n\n        # Neither 'a' nor 'b' should exist\n        assert not db.search(Query().a == 1)\n        assert not db.search(Query().b == 2)\n        db.close()\n\n    def test_inner_rollback_clears_cache(self):\n        \"\"\"R13: Preexisting table handles and warmed query caches reflect\n        the current active savepoint after inner rollback.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with db.transaction():\n            db.insert({'value': 2})\n            with db.transaction():\n                db.insert({'value': 3})\n                assert db.search(Query().value == 3)  # Populate cache\n                raise ValueError('inner')\n            # After inner rollback, value==3 should not be found\n            assert not db.search(Query().value == 3)\n            # But value==2 should still be visible\n            assert db.search(Query().value == 2)\n\n        db.close()\n\n\nclass TestTransactionWithTables:\n    \"\"\"Test transaction behavior with multiple tables.\"\"\"\n\n    def test_table_creation_rollback(self):\n        \"\"\"R05: Table creation/deletion rolled back.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                tbl = db.table('new_table')\n                tbl.insert({'value': 1})\n                raise ValueError('rollback')\n\n        assert 'new_table' not in db.tables()\n        db.close()\n\n    def test_table_deletion_rollback(self):\n        \"\"\"R05: Table deletion rolled back.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        tbl = db.table('to_delete')\n        tbl.insert({'value': 1})\n        assert 'to_delete' in db.tables()\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.drop_table('to_delete')\n                raise ValueError('rollback')\n\n        assert 'to_delete' in db.tables()\n        db.close()\n\n    def test_update_multiple_tables_commit(self):\n        \"\"\"R03: Updates to multiple tables committed atomically.\"\"\"\n        db = TransactionalTinyDB(storage=CountingStorage)\n        backend = CountingStorage.last\n        \n        # Create tables first\n        tbl1 = db.table('table1')\n        tbl2 = db.table('table2')\n        tbl1.insert({'table': 1})\n        tbl2.insert({'table': 2})\n        \n        # Clear writes after setup\n        backend.writes.clear()\n\n        with db.transaction():\n            tbl1.update({'updated': True})\n            tbl2.update({'updated': True})\n\n        assert len(backend.writes) == 1\n        assert tbl1.get(Query().table == 1)['updated'] is True\n        assert tbl2.get(Query().table == 2)['updated'] is True\n        db.close()\n\n\nclass TestTransactionWithJSONStorage:\n    \"\"\"Test transaction behavior with JSONStorage.\"\"\"\n\n    def test_json_persistence_after_commit(self, tmp_path):\n        \"\"\"R08: Committed data survives close/reopen.\"\"\"\n        path = tmp_path / 'test.json'\n        db = TransactionalTinyDB(str(path))\n\n        with db.transaction():\n            db.insert({'value': 1})\n\n        db.close()\n\n        with TinyDB(str(path)) as check:\n            assert check.all() == [{'value': 1}]\n\n    def test_json_unchanged_after_rollback(self, tmp_path):\n        \"\"\"R08: Rollback leaves persisted state unchanged.\"\"\"\n        path = tmp_path / 'test.json'\n        db = TransactionalTinyDB(str(path))\n        db.insert({'initial': True})\n        db.close()\n\n        with TransactionalTinyDB(str(path)) as db:\n            with pytest.raises(ValueError):\n                with db.transaction():\n                    db.truncate()\n                    raise ValueError('rollback')\n\n        with TinyDB(str(path)) as check:\n            assert check.all() == [{'initial': True}]\n\n\nclass TestTransactionEdgeCases:\n    \"\"\"Test edge cases and error handling.\"\"\"\n\n    def test_empty_transaction(self):\n        \"\"\"Empty transaction should work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with db.transaction():\n            pass  # Do nothing\n\n        assert len(db) == 0\n        db.close()\n\n    def test_transaction_with_no_changes(self):\n        \"\"\"Transaction with only reads should work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with db.transaction():\n            assert db.search(Query().value == 1)\n\n        assert len(db) == 1\n        db.close()\n\n    def test_transaction_close_doesnt_crash(self):\n        \"\"\"Closing db outside transaction should work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n        db.close()\n\n    def test_multiple_transactions_sequential(self):\n        \"\"\"Multiple sequential transactions should work.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        for i in range(5):\n            with db.transaction():\n                db.insert({'value': i})\n\n        assert len(db) == 5\n        db.close()\n\n    def test_transaction_with_search_results(self):\n        \"\"\"Search results within transaction reflect changes.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n\n        with db.transaction():\n            db.insert({'value': 2})\n            results = db.search(Query().value > 0)\n            assert len(results) == 2\n\n        assert len(db) == 2\n        db.close()\n\n    def test_transaction_with_remove(self):\n        \"\"\"Remove within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n        db.insert({'value': 2})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.remove(Query().value == 2)\n                raise ValueError('rollback')\n\n        assert len(db) == 2\n        db.close()\n\n    def test_transaction_with_upsert(self):\n        \"\"\"Upsert within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1, 'name': 'original'})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.upsert({'value': 1, 'name': 'modified'}, Query().value == 1)\n                raise ValueError('rollback')\n\n        assert db.get(Query().value == 1)['name'] == 'original'\n        db.close()\n\n    def test_transaction_with_truncate(self):\n        \"\"\"Truncate within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n        db.insert({'value': 2})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.truncate()\n                raise ValueError('rollback')\n\n        assert len(db) == 2\n        db.close()\n\n    def test_transaction_with_drop_tables(self):\n        \"\"\"drop_tables within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert({'value': 1})\n        db.table('other').insert({'value': 2})\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.drop_tables()\n                raise ValueError('rollback')\n\n        assert len(db) == 1\n        assert 'other' in db.tables()\n        db.close()\n\n    def test_transaction_with_insert_multiple(self):\n        \"\"\"insert_multiple within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.insert_multiple([{'value': i} for i in range(5)])\n                raise ValueError('rollback')\n\n        assert len(db) == 0\n        db.close()\n\n    def test_transaction_with_update_multiple(self):\n        \"\"\"update_multiple within transaction should be rollback-able.\"\"\"\n        db = TransactionalTinyDB(storage=MemoryStorage)\n        db.insert_multiple([{'value': i} for i in range(5)])\n\n        with pytest.raises(ValueError):\n            with db.transaction():\n                db.update_multiple([({'updated': True}, Query().value == 1), \n                                   ({'updated': True}, Query().value == 2)])\n                raise ValueError('rollback')\n\n        assert db.get(Query().value == 1).get('updated') is None\n        assert db.get(Query().value == 2).get('updated') is None\n        db.close()\nPYEOF", "exit_code": 0, "stderr": "", "stdout": ""}