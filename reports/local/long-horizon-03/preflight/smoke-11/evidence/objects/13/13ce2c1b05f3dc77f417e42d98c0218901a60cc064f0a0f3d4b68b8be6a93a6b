{"command": "# Phase 2: T003 - Create test_smoke.py with all test cases\ncat > /testbed/tests/test_smoke.py << 'TESTS_EOF'\n\"\"\"Test suite for smoke.py arithmetic utility.\"\"\"\n\nimport pytest\nfrom smoke import add\n\n\n# ============================================================\n# User Story 1: Basic Addition (Priority: P1)\n# ============================================================\n\nclass TestBasicAddition:\n    \"\"\"Tests for basic integer addition (US1).\"\"\"\n\n    def test_add_positive_integers(self):\n        \"\"\"Test that add(2, 3) returns 5.\"\"\"\n        assert add(2, 3) == 5\n\n    def test_add_zeros(self):\n        \"\"\"Test that add(0, 0) returns 0.\"\"\"\n        assert add(0, 0) == 0\n\n\n# ============================================================\n# User Story 2: Float Support (Priority: P2)\n# ============================================================\n\nclass TestFloatSupport:\n    \"\"\"Tests for float and mixed-type addition (US2).\"\"\"\n\n    def test_add_floats(self):\n        \"\"\"Test that add(1.5, 2.5) returns 4.0.\"\"\"\n        assert add(1.5, 2.5) == 4.0\n\n    def test_add_floats_precision(self):\n        \"\"\"Test that add(0.1, 0.2) returns 0.3.\"\"\"\n        assert add(0.1, 0.2) == 0.3\n\n    def test_add_mixed_int_float(self):\n        \"\"\"Test that add(1, 2.5) returns 3.5.\"\"\"\n        assert add(1, 2.5) == 3.5\n\n    def test_add_mixed_float_int(self):\n        \"\"\"Test that add(2.5, 1) returns 3.5.\"\"\"\n        assert add(2.5, 1) == 3.5\n\n\n# ============================================================\n# User Story 3: Zero and Negative Values (Priority: P3)\n# ============================================================\n\nclass TestZeroAndNegativeValues:\n    \"\"\"Tests for zero and negative value handling (US3).\"\"\"\n\n    def test_add_negative_integers(self):\n        \"\"\"Test that add(-5, -3) returns -8.\"\"\"\n        assert add(-5, -3) == -8\n\n    def test_add_negative_and_positive(self):\n        \"\"\"Test that add(-1, 1) returns 0.\"\"\"\n        assert add(-1, 1) == 0\n\n    def test_add_positive_and_zero(self):\n        \"\"\"Test that add(10, 0) returns 10.\"\"\"\n        assert add(10, 0) == 10\n\n    def test_add_zero_and_negative(self):\n        \"\"\"Test that add(0, -7) returns -7.\"\"\"\n        assert add(0, -7) == -7\n\n    def test_add_negative_float(self):\n        \"\"\"Test that add(-0.5, 0.5) returns 0.0.\"\"\"\n        assert add(-0.5, 0.5) == 0.0\n\n\n# ============================================================\n# Edge Cases\n# ============================================================\n\nclass TestEdgeCases:\n    \"\"\"Tests for edge cases and error conditions.\"\"\"\n\n    def test_add_large_integers(self):\n        \"\"\"Test that add handles large integers.\"\"\"\n        assert add(10**15, 10**15) == 2 * 10**15\n\n    def test_add_negative_float(self):\n        \"\"\"Test that add(-1.5, -2.5) returns -4.0.\"\"\"\n        assert add(-1.5, -2.5) == -4.0\n\n    def test_add_zero_float(self):\n        \"\"\"Test that add(0.0, 0.0) returns 0.0.\"\"\"\n        assert add(0.0, 0.0) == 0.0\n\n    def test_add_type_error_string(self):\n        \"\"\"Test that add raises TypeError for string inputs.\"\"\"\n        with pytest.raises(TypeError):\n            add(\"1\", \"2\")\n\n    def test_add_type_error_none(self):\n        \"\"\"Test that add raises TypeError for None input.\"\"\"\n        with pytest.raises(TypeError):\n            add(1, None)\nTESTS_EOF\necho \"T003: test_smoke.py created with all tests\"", "exit_code": 0, "stderr": "", "stdout": "T003: test_smoke.py created with all tests\n"}