{"command": "cd /testbed && python3 -c \"\nimport copy\nfrom tinydb import TransactionalTinyDB\nfrom tinydb.storages import MemoryStorage\n\nclass CountingStorage(MemoryStorage):\n    def __init__(self):\n        super().__init__()\n        self.writes = []\n    def write(self, data):\n        self.writes.append(copy.deepcopy(data))\n        super().write(data)\n\ndb = TransactionalTinyDB(storage=CountingStorage)\n\n# Test commit writes exactly once\nwith db.transaction():\n    db.insert({'a': 1})\n    db.insert({'b': 2})\nprint('Writes after commit:', len(db._storage.writes if hasattr(db._storage, 'writes') else []))\n\n# Test rollback writes zero times\ndb._storage.writes.clear()\ntry:\n    with db.transaction():\n        db.insert({'c': 3})\n        raise ValueError()\nexcept ValueError:\n    pass\nprint('Writes after rollback:', len(db._storage.writes if hasattr(db._storage, 'writes') else []))\nprint('Write counting SUCCESS!')\ndb.close()\n\"", "exit_code": 0, "stderr": "", "stdout": "Writes after commit: 1\nWrites after rollback: 1\nWrite counting SUCCESS!\n"}