{"command": "cat > /testbed/tinydb/transactional.py << 'TRANSACTIONAL_EOF'\n\"\"\"\nTransactionalTinyDB - Opt-in transactional support for TinyDB.\n\nThis module provides TransactionalTinyDB, a subclass of TinyDB that adds\nsingle-instance, single-thread transactional semantics via a context manager.\n\nUsage:\n\n    from tinydb import TransactionalTinyDB\n    from tinydb.storages import MemoryStorage\n\n    db = TransactionalTinyDB(storage=MemoryStorage)\n\n    with db.transaction() as current:\n        assert current is db\n        db.insert({'key': 'value'})\n        # Changes are buffered, not written to storage\n    # On exit: changes are written to storage exactly once\n\n    # Rollback on exception:\n    try:\n        with db.transaction():\n            db.insert({'key': 'value'})\n            raise ValueError('abort')\n    except ValueError:\n        pass\n    # Original data is preserved, zero writes occurred\n\nConstraints:\n- Single-instance, single-thread only\n- MemoryStorage and JSONStorage backends supported\n- No power-loss durability guarantee\n- Nesting transaction() calls raises RuntimeError\n\"\"\"\n\nimport copy\nfrom typing import TYPE_CHECKING\n\nfrom .database import TinyDB\n\nif TYPE_CHECKING:\n    from typing import Any, Type\n\n\nclass TransactionContext:\n    \"\"\"Context manager that provides transactional semantics for TinyDB.\n\n    Takes a deep copy of the storage data on entry, intercepts storage writes\n    (making them no-ops), and on exit either commits (writes once) or rolls\n    back (restores the snapshot and clears query caches).\n    \"\"\"\n\n    def __init__(self, db: \"TransactionalTinyDB\") -> None:\n        \"\"\"Initialize the transaction context.\n\n        Args:\n            db: The TransactionalTinyDB instance to use.\n        \"\"\"\n        self._db = db\n        self._storage = db._storage\n        self._snapshot: Any = None\n        self._original_write = None\n\n    def __enter__(self) -> \"TransactionalTinyDB\":\n        \"\"\"Enter the transaction context.\n\n        Takes a deep copy of the current storage data, replaces storage.write\n        with a no-op, and returns the database instance.\n\n        Returns:\n            The TransactionalTinyDB instance (same object).\n\n        Raises:\n            RuntimeError: If a transaction is already active (nesting not supported).\n        \"\"\"\n        # Check for nesting\n        if hasattr(self._db, '_in_transaction') and self._db._in_transaction:\n            raise RuntimeError(\n                \"Nesting transactions is not supported. \"\n                \"A transaction is already active.\"\n            )\n\n        # Mark as in transaction\n        self._db._in_transaction = True\n\n        # Take a snapshot of the current storage data\n        self._snapshot = copy.deepcopy(self._storage.read())\n\n        # Replace write with no-op\n        self._original_write = self._storage.write\n        self._storage.write = lambda data: None  # type: ignore[assignment]\n\n        return self._db\n\n    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool:\n        \"\"\"Exit the transaction context.\n\n        On success: writes the accumulated state once.\n        On exception: restores the snapshot, clears all query caches, and\n        propagates the exception.\n\n        Args:\n            exc_type: Exception type if an exception was raised, None otherwise.\n            exc_val: Exception value if an exception was raised, None otherwise.\n            exc_tb: Exception traceback if an exception was raised, None otherwise.\n\n        Returns:\n            False to propagate any exception.\n        \"\"\"\n        # Restore the original write method\n        self._storage.write = self._original_write  # type: ignore[assignment]\n\n        if exc_type is None:\n            # Commit: write the current state once\n            self._storage.write(self._storage.read())\n        else:\n            # Rollback: restore snapshot\n            self._storage.write(self._snapshot)  # type: ignore[arg-type]\n            # Clear all query caches\n            for table in self._db._tables.values():\n                table.clear_cache()\n\n        # Clear the in_transaction flag\n        self._db._in_transaction = False\n\n        return False  # Don't suppress exceptions\n\n\nclass TransactionalTinyDB(TinyDB):\n    \"\"\"A TinyDB subclass that provides transactional semantics.\n\n    TransactionalTinyDB accepts the same constructor arguments as TinyDB\n    and adds a transaction() method that returns a context manager for\n    atomic operations.\n\n    Example:\n        >>> from tinydb import TransactionalTinyDB, where\n        >>> from tinydb.storages import MemoryStorage\n        >>> db = TransactionalTinyDB(storage=MemoryStorage)\n        >>> with db.transaction() as current:\n        ...     db.insert({'data': 42})\n        >>> # Data is now persisted\n        >>> len(db)\n        1\n    \"\"\"\n\n    def __init__(self, *args: Any, **kwargs: Any) -> None:\n        \"\"\"Create a new TransactionalTinyDB instance.\n\n        All arguments and keyword arguments are passed through to the\n        TinyDB constructor (which then passes them to the storage class).\n\n        Args:\n            *args: Positional arguments passed to the storage class.\n            **kwargs: Keyword arguments passed to the storage class.\n        \"\"\"\n        super().__init__(*args, **kwargs)\n        self._in_transaction: bool = False\n\n    def transaction(self) -> TransactionContext:\n        \"\"\"Create a new transaction context.\n\n        Returns a context manager that yields the database instance.\n        Mutations within the context are buffered and written exactly\n        once on successful exit. On exception, all changes are rolled back.\n\n        Returns:\n            A TransactionContext object.\n\n        Raises:\n            RuntimeError: If a transaction is already active (nesting not supported).\n\n        Example:\n            >>> with db.transaction() as current:\n            ...     db.insert({'key': 'value'})\n            ...     current is db  # True\n        \"\"\"\n        return TransactionContext(self)\nTRANSACTIONAL_EOF\n", "exit_code": 0, "stderr": "", "stdout": ""}