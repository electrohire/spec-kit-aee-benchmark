{"command": "cd /testbed && cat >> tests/test_journal.py << 'EOF'\n\n\n# --- Milestone 2 -----------------------------------------------------------\n\nclass _PlainMapping:\n    \"\"\"A Mapping that is not a dict (R04: non-dict documents are rejected).\"\"\"\n\n    def __init__(self, data):\n        self._data = data\n\n    def __getitem__(self, key):\n        return self._data[key]\n\n    def __iter__(self):\n        return iter(self._data)\n\n    def __len__(self):\n        return len(self._data)\n\n    def __eq__(self, other):\n        return isinstance(other, _PlainMapping) and self._data == other._data\n\n\ndef test_empty_dict_document_accepted(env):\n    db, w = env\n    assert w.apply([{'op': 'insert', 'document': {}}]) == [1]\n    assert db.all() == [{}]\n\n\ndef test_non_dict_document_rejected(env):\n    db, w = env\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': _PlainMapping({'x': 1})}])\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'insert', 'document': _PlainMapping({'x': 1})}])\n    assert db.all() == []\n\n\ndef test_unsupported_fields_rejected(env):\n    db, w = env\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 1}, 'extra': 1}])\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 1, 'extra': 1}])\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'insert', 'document': {}, 'extra': 1}])\n    assert db.all() == []\n\n\ndef test_validation_happens_before_any_commit(env):\n    db, w = env\n    db.insert({'x': 1})\n    # Malformed op *after* valid ops: nothing may be committed\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 2}},\n                 {'op': 'remove', 'doc_id': 99},\n                 {'op': 'insert', 'document': 'bad'}])\n    assert [d['x'] for d in db.all()] == [1]\n    # Malformed op *before* valid ops: nothing may be committed\n    with pytest.raises(ValueError