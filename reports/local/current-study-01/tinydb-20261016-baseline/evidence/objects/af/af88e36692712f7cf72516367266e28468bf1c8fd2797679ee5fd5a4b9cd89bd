unction's\n            # parameter and is an optional `int`.\n            for doc_id_, doc in self._read_table().items():\n                if cond(doc):\n                    return self.document_class(\n                        doc,\n                        self.document_id_class(doc_id_)\n                    )\n\n            return None\n\n        raise RuntimeError('You have to pass either cond or doc_id or doc_ids')\n\n    def contains(\n"}