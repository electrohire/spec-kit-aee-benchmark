{"command": "cd /testbed && git status --short; echo ===; cat tinydb/journal.py", "exit_code": 0, "stderr": "", "stdout": "?? TASK_STAGE_1.md\n?? acceptance_public.py\n?? tests/test_journal.py\n?? tinydb/journal.py\n===\n\"\"\"\nThis module provides a small batch-writing helper for TinyDB.\n\n:class:`~tinydb.journal.BatchWriter` wraps a ``TinyDB`` instance and lets\nyou apply a list of simple operations (inserts and removes) to the default\ntable atomically: either every operation succeeds, or the default table is\nrestored to the state it had before the batch started.\n\"\"\"\n\nimport copy\nfrom collections.abc import Mapping\n\nfrom .database import TinyDB\n\n__all__ = ('BatchWriter',)\n\n\nclass BatchWriter:\n    \"\"\"\n    Apply batches of insert/remove operations to a TinyDB's default table.\n\n    The writer wraps an existing ``TinyDB`` instance and does not change any\n    of its ordinary APIs. All operations are applied to the default table\n    (``db.default_table_name``).\n\n    Each operation is a dictionary of one of the following forms:\n\n    - ``{'op': 'insert', 'document': <mapping>}`` inserts a new document\n    - ``{'op': 'remove', 'doc_id': <positive integer>}`` removes an existing\n      document\n\n    Batches are atomic: if any operation fails (e.g. removing a document ID\n    that does not exist, or a malformed operation), the default table is\n    restored to the exact state it had before the batch started and the\n    error is re-raised.\n    \"\"\"\n\n    def __init__(self, db: TinyDB):\n        \"\"\"\n        Create a batch writer for the given TinyDB instance.\n\n        :param db: the TinyDB instance to wrap\n        \"\"\"\n        self._db = db\n\n    def apply(self, operations) -> list[int]:\n        \"\"\"\n        Apply a batch of operations to the default table atomically.\n\n        :param operations: a list of operation dictionaries\n        :returns: a list containing the IDs of all inserted documents\n                  (in insertion order); removes do not contribute results\n        :raises ValueError: if the batch or any operation is malformed, or if\n                            a remove targets a document ID that does not\n                            exist\n        \"\"\"\n        # --- Validate the batch itself -------------------------------------\n        if not isinstance(operations, (list, tuple)):\n            raise ValueError('operations must be a list of operation dicts')\n\n        # --- Snapshot the pre-batch database state -------------------------\n        # We keep a deep copy of the object returned by the storage (which\n        # may be ``None`` for an empty database) so we can restore the exact\n        # state later. A deep copy is required because storages such as\n        # ``MemoryStorage`` return the very dict they hold, which would be\n        # mutated by the batch itself.\n        snapshot = copy.deepcopy(self._db.storage.read())\n\n        table = self._db.table(self._db.default_table_name)\n\n        inserted_ids: list[int] = []\n\n        try:\n            for op in operations:\n                # --- Validate the operation --------------------------------\n                if not isinstance(op, Mapping):\n                    raise ValueError(\n                        f'Operation is not a mapping: {op!r}'\n                    )\n\n                op_name = op.get('op')\n\n                if op_name == 'insert':\n                    if 'document' not in op:\n                        raise ValueError(\n                            \"'insert' operation is missing 'document'\"\n                        )\n                    document = op['document']\n                    if not isinstance(document, Mapping):\n                        raise ValueError(\n                            f\"'document' is not a mapping: {document!r}\"\n                        )\n\n                    # Deep-copy the document so that the database never\n                    # aliases the caller's input (and mutating the\n                    # operation after ``apply`` cannot mutate the database).\n                    doc_id = table.insert(copy.deepcopy(dict(document)))\n                    inserted_ids.append(doc_id)\n\n                elif op_name == 'remove':\n                    if 'doc_id' not in op:\n                        raise ValueError(\n                            \"'remove' operation is missing 'doc_id'\"\n                        )\n                    doc_id = op['doc_id']\n                    # A positive integer is required. Note that ``bool`` is\n                    # a subclass of ``int``, so it is rejected explicitly.\n                    if isinstance(doc_id, bool) or not isinstance(doc_id, int):\n                        raise ValueError(\n                            f\"'doc_id' is not a positive integer: {doc_id!r}\"\n                        )\n                    if doc_id <= 0:\n                        raise ValueError(\n                            f\"'doc_id' is not a positive integer: {doc_id!r}\"\n                        )\n\n                    # ``Table.remove(doc_ids=...)`` silently skips missing\n                    # IDs, but for a batch a missing ID is an error. Check\n                    # against the *current* table state (earlier operations\n                    # in this batch are already visible).\n                    if table.get(doc_id=doc_id) is None:\n                        raise ValueError(\n                            f\"Cannot remove document with ID {doc_id}: \"\n                            f'document does not exist'\n                        )\n\n                    table.remove(doc_ids=[doc_id])\n\n                else:\n                    raise ValueError(f'Unknown operation: {op_name!r}')\n        except Exception:\n            # --- Rollback ---------------------------------------------------\n            # Restore the exact pre-batch storage state. This makes both the\n            # storage and any previously acquired table handles (which read\n            # through to the storage) reflect the rollback.\n            self._db.storage.write(snapshot)\n\n            # Reset the table's internal state so it is consistent with the\n            # restored data: the cached next-ID counter may have advanced\n            # during the failed batch, and the query cache may hold stale\n            # results. (``storage.write`` above already cleared the query\n            # cache, but be explicit.)\n            table._next_id = None\n            table.clear_cache()\n\n            raise\n\n        return inserted_ids\n"}