{"command": "head -80 /testbed/tests/test_journal.py; echo ===; git -C /testbed diff --stat HEAD -- tests/ tinydb/ | tail -5", "exit_code": 0, "stderr": "", "stdout": "\"\"\"\nTests for tinydb.journal.BatchWriter (milestone 1).\n\"\"\"\nimport pytest\n\nfrom tinydb import TinyDB, where\nfrom tinydb.storages import MemoryStorage, JSONStorage\nfrom tinydb.journal import BatchWriter\n\n\n@pytest.fixture(params=['memory', 'json'])\ndef env(request, tmp_path):\n    if request.param == 'memory':\n        db = TinyDB(storage=MemoryStorage)\n    else:\n        db = TinyDB(tmp_path / 'journal.db', storage=JSONStorage)\n    writer = BatchWriter(db)\n    db.drop_tables()\n    return db, writer\n\n\n# --- R01: basic apply semantics -------------------------------------------\n\ndef test_empty_batch(env):\n    db, w = env\n    assert w.apply([]) == []\n    assert db.all() == []\n\n\ndef test_insert_returns_ids(env):\n    db, w = env\n    assert w.apply([{'op': 'insert', 'document': {'x': 1}},\n                    {'op': 'insert', 'document': {'x': 2}}]) == [1, 2]\n    assert [d['x'] for d in db.all()] == [1, 2]\n\n\ndef test_remove_returns_empty(env):\n    db, w = env\n    db.insert({'x': 1})\n    assert w.apply([{'op': 'remove', 'doc_id': 1}]) == []\n    assert db.all() == []\n\n\ndef test_mixed_batch(env):\n    db, w = env\n    db.insert({'x': 0})\n    ids = w.apply([\n        {'op': 'insert', 'document': {'x': 1}},\n        {'op': 'remove', 'doc_id': 1},\n        {'op': 'insert', 'document': {'x': 2}},\n    ])\n    assert ids == [2, 3]\n    assert [d['x'] for d in db.all()] == [1, 2]\n\n\ndef test_unknown_op_raises(env):\n    db, w = env\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'update', 'document': {'x': 1}}])\n    with pytest.raises(ValueError):\n        w.apply([{'op': None}])\n    with pytest.raises(ValueError):\n        w.apply([{}])\n\n\ndef test_malformed_ops_raise(env):\n    db, w = env\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert'}])  # missing document\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': 'nope'}])\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': 42}])\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove'}])  # missing doc_id\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 0}])\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': -1}])\n    with pytest.raises(ValueError):\n===\n"}