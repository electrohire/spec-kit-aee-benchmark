{"command": "sed -n 120,200p /testbed/tinydb/journal.py", "exit_code": 0, "stderr": "", "stdout": "                    # ``Table.remove(doc_ids=...)`` silently skips missing\n                    # IDs, but for a batch a missing ID is an error. Check\n                    # against the *current* table state (earlier operations\n                    # in this batch are already visible).\n                    if table.get(doc_id=doc_id) is None:\n                        raise ValueError(\n                            f\"Cannot remove document with ID {doc_id}: \"\n                            f'document does not exist'\n                        )\n\n                    table.remove(doc_ids=[doc_id])\n        except Exception:\n            # --- Rollback ---------------------------------------------------\n            # Restore the exact pre-batch storage state. This makes both the\n            # storage and any previously acquired table handles (which read\n            # through to the storage) reflect the rollback.\n            self._db.storage.write(snapshot)\n\n            # Reset the table's internal state so it is consistent with the\n            # restored data: the cached next-ID counter may have advanced\n            # during the failed batch, and the query cache may hold stale\n            # results. (``storage.write`` above already cleared the query\n            # cache, but be explicit.) A failed batch must not consume IDs.\n            table._next_id = None\n            table.clear_cache()\n\n            raise\n\n        # --- Commit the wrapper's next-insertion-ID state -------------------\n        # Write the advanced state back to the underlying table so that\n        # subsequent inserts (via ``apply`` or direct ``db.insert``)\n        # continue the sequence without reuse or rewind, even across\n        # remove operations.\n        self._next_id = next_id\n        table._next_id = next_id\n\n        return inserted_ids\n\n    def preview(self, operations) -> list[int]:\n        \"\"\"\n        Preview the IDs that :meth:`apply` would assign to inserted\n        documents, without changing anything.\n\n        The batch is validated with exactly the same rules as :meth:`apply`\n        (so a malformed batch raises ``ValueError`` here as well), but no\n        data is written, no document IDs are consumed, and the query cache\n        is left untouched. Even on error, all data and the next insertion ID\n        remain unchanged.\n\n        :param operations: a list of operation dictionaries\n        :returns: a new, detached list of the IDs that would be inserted\n                  (in insertion order); removes do not contribute results\n        :raises ValueError: if the batch or any operation is malformed, or if\n                            a remove targets a document ID that does not\n                            exist (mirroring :meth:`apply`)\n        \"\"\"\n        ops = self._validate_operations(operations)\n\n        table = self._db.table(self._db.default_table_name)\n\n        # Simulate the batch on a deep copy of the current storage state so\n        # that neither the storage, the table's cached next-ID counter, nor\n        # the query cache is modified in any way.\n        raw = self._db.storage.read()\n        data = copy.deepcopy(raw) if raw is not None else {}\n        raw_table = data.get(self._db.default_table_name)\n        sim = {\n            table.document_id_class(doc_id): doc\n            for doc_id, doc in (raw_table or {}).items()\n        }\n\n        next_id = self._resolve_next_id(table)\n\n        inserted_ids: list[int] = []\n        for op in ops:\n            if op['op'] == 'insert':\n                inserted_ids.append(next_id)\n                sim[next_id] = copy.deepcopy(dict(op['document']))\n                next_id += 1\n            else:  # 'remove'\n                doc_id = op['doc_id']\n"}