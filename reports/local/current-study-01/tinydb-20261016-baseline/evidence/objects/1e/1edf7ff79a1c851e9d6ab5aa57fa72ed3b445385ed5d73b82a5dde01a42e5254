{"command": "cat /testbed/tinydb/journal.py; echo ===; git -C /testbed status --short; echo ===; ls /testbed/tests", "exit_code": 0, "stderr": "", "stdout": "\"\"\"\nThis module provides a small batch-writing helper for TinyDB.\n\n:class:`~tinydb.journal.BatchWriter` wraps a ``TinyDB`` instance and lets\nyou apply a list of simple operations (inserts and removes) to the default\ntable atomically: either every operation succeeds, or the default table is\nrestored to the state it had before the batch started.\n\"\"\"\n\nimport copy\n\nfrom .database import TinyDB\n\n__all__ = ('BatchWriter',)\n\n\nclass BatchWriter:\n    \"\"\"\n    Apply batches of insert/remove operations to a TinyDB's default table.\n\n    The writer wraps an existing ``TinyDB`` instance and does not change any\n    of its ordinary APIs. All operations are applied to the default table\n    (``db.default_table_name``).\n\n    Each operation is a dictionary of one of the following forms (no extra\n    fields are allowed):\n\n    - ``{'op': 'insert', 'document': <dict>}`` inserts a new document; an\n      empty dictionary is a valid document\n    - ``{'op': 'remove', 'doc_id': <positive integer>}`` removes an existing\n      document; ``bool`` is rejected even though it subclasses ``int``\n\n    Batches are atomic: if any operation fails (e.g. removing a document ID\n    that does not exist, or a malformed operation), the default table is\n    restored to the exact state it had before the batch started and the\n    error is re-raised. A failed batch never consumes document IDs.\n\n    The writer keeps its own next-insertion-ID state. On every successful\n    batch that state is written back to the underlying table so that\n    subsequent inserts -- via :meth:`apply` or a direct ``db.insert`` --\n    continue the ID sequence without reuse or rewind, even when the batch\n    contained removes.\n    \"\"\"\n\n    #: Fields that are allowed in an ``insert`` operation\n    _INSERT_FIELDS = frozenset(('op', 'document'))\n\n    #: Fields that are allowed in a ``remove`` operation\n    _REMOVE_FIELDS = frozenset(('op', 'doc_id'))\n\n    def __init__(self, db: TinyDB):\n        \"\"\"\n        Create a batch writer for the given TinyDB instance.\n\n        :param db: the TinyDB instance to wrap\n        \"\"\"\n        self._db = db\n        # The wrapper's own next-insertion-ID state. ``None`` means \"derive\n        # it from the table on the next successful batch\". It is never\n        # consumed by :meth:`preview` or by a failed :meth:`apply`.\n        self._next_id = None\n\n    # ------------------------------------------------------------------ #\n    # Public API\n    # ------------------------------------------------------------------ #\n\n    def apply(self, operations) -> list[int]:\n        \"\"\"\n        Apply a batch of operations to the default table atomically.\n\n        All operations are validated structurally before any change is\n        committed. The batch is then applied sequentially; if any operation\n        fails (e.g. a remove targeting a missing document), the complete\n        pre-batch state is restored and the error is re-raised.\n\n        :param operations: a list of operation dictionaries\n        :returns: a new list containing the IDs of all inserted documents\n                  (in insertion order); removes do not contribute results\n        :raises ValueError: if the batch or any operation is malformed, or if\n                            a remove targets a document ID that does not\n                            exist\n        \"\"\"\n        ops = self._validate_operations(operations)\n\n        table = self._db.table(self._db.default_table_name)\n\n        # Determine the starting ID for this batch. Direct ``db.insert``\n        # calls between batches are visible because we fall back to the\n        # table's own state (which includes its cached ``_next_id``).\n        start_id = self._resolve_next_id(table)\n\n        # --- Snapshot the pre-batch database state -------------------------\n        # We keep a deep copy of the object returned by the storage (which\n        # may be ``None`` for an empty database) so we can restore the exact\n        # state later. A deep copy is required because storages such as\n        # ``MemoryStorage`` return the very dict they hold, which would be\n        # mutated by the batch itself.\n        snapshot = copy.deepcopy(self._db.storage.read())\n\n        inserted_ids: list[int] = []\n\n        try:\n            next_id = start_id\n            for op in ops:\n                op_name = op['op']\n\n                if op_name == 'insert':\n                    document = op['document']\n\n                    # Deep-copy the document so that the database never\n                    # aliases the caller's input (and mutating the\n                    # operation after ``apply`` cannot mutate the database).\n                    table.insert(copy.deepcopy(dict(document)))\n                    inserted_ids.append(next_id)\n                    next_id += 1\n\n                else:  # 'remove'\n                    doc_id = op['doc_id']\n\n                    # ``Table.remove(doc_ids=...)`` silently skips missing\n                    # IDs, but for a batch a missing ID is an error. Check\n                    # against the *current* table state (earlier operations\n                    # in this batch are already visible).\n                    if table.get(doc_id=doc_id) is None:\n                        raise ValueError(\n                            f\"Cannot remove document with ID {doc_id}: \"\n                            f'document does not exist'\n                        )\n\n                    table.remove(doc_ids=[doc_id])\n        except Exception:\n            # --- Rollback ---------------------------------------------------\n            # Restore the exact pre-batch storage state. This makes both the\n            # storage and any previously acquired table handles (which read\n            # through to the storage) reflect the rollback.\n            self._db.storage.write(snapshot)\n\n            # Reset the table's internal state so it is consistent with the\n            # restored data: the cached next-ID counter may have advanced\n            # during the failed batch, and the query cache may hold stale\n            # results. (``storage.write`` above already cleared the query\n            # cache, but be explicit.) A failed batch must not consume IDs.\n            table._next_id = None\n            table.clear_cache()\n\n            raise\n\n        # --- Commit the wrapper's next-insertion-ID state -------------------\n        # Write the advanced state back to the underlying table so that\n        # subsequent inserts (via ``apply`` or direct ``db.insert``)\n        # continue the sequence without reuse or rewind, even across\n        # remove operations.\n        self._next_id = next_id\n        table._next_id = next_id\n\n        return inserted_ids\n\n    def preview(self, operations) -> list[int]:\n        \"\"\"\n        Preview the IDs that :meth:`apply` would assign to inserted\n        documents, without changing anything.\n\n        The batch is validated with exactly the same rules as :meth:`apply`\n        (so a malformed batch raises ``ValueError`` here as well), but no\n        data is written, no document IDs are consumed, and the query cache\n        is left untouched. Even on error, all data and the next insertion ID\n        remain unchanged.\n\n        :param operations: a list of operation dictionaries\n        :returns: a new, detached list of the IDs that would be inserted\n                  (in insertion order); removes do not contribute results\n        :raises ValueError: if the batch or any operation is malformed, or if\n                            a remove targets a document ID that does not\n                            exist (mirroring :meth:`apply`)\n        \"\"\"\n        ops = self._validate_operations(operations)\n\n        table = self._db.table(self._db.default_table_name)\n\n        # Simulate the batch on a deep copy of the current storage state so\n        # that neither the storage, the table's cached next-ID counter, nor\n        # the query cache is modified in any way.\n        raw = self._db.storage.read()\n        data = copy.deepcopy(raw) if raw is not None else {}\n        raw_table = data.get(self._db.default_table_name)\n        sim = {\n            table.document_id_class(doc_id): doc\n            for doc_id, doc in (raw_table or {}).items()\n        }\n\n        next_id = self._resolve_next_id(table)\n\n        inserted_ids: list[int] = []\n        for op in ops:\n            if op['op'] == 'insert':\n                inserted_ids.append(next_id)\n                sim[next_id] = copy.deepcopy(dict(op['document']))\n                next_id += 1\n            else:  # 'remove'\n                doc_id = op['doc_id']\n                if doc_id not in sim:\n                    # Mirror ``apply``: a remove targeting a missing ID is an\n                    # error. Nothing was written, so all data and the next\n                    # insertion ID are unchanged.\n                    raise ValueError(\n                        f\"Cannot remove document with ID {doc_id}: \"\n                        f'document does not exist'\n                    )\n                del sim[doc_id]\n\n        # Return a fresh list on every call; the caller may mutate it\n        # without affecting subsequent previews or the writer's state.\n        return list(inserted_ids)\n\n    # ------------------------------------------------------------------ #\n    # Internal helpers\n    # ------------------------------------------------------------------ #\n\n    def _validate_operations(self, operations) -> list[dict]:\n        \"\"\"\n        Structurally validate a batch of operations before any change is\n        committed.\n\n        :returns: the operations as a list of dicts\n        :raises ValueError: if the batch or any operation is malformed\n        \"\"\"\n        # The batch itself must be a list of operation dictionaries.\n        if not isinstance(operations, list):\n            raise ValueError(\n                f'operations must be a list of operation dicts: '\n                f'{operations!r}'\n            )\n\n        for op in operations:\n            if not isinstance(op, dict):\n                raise ValueError(f'Operation is not a dict: {op!r}')\n\n            op_name = op.get('op')\n\n            if op_name == 'insert':\n                if set(op.keys()) != self._INSERT_FIELDS:\n                    raise ValueError(\n                        f\"'insert' operation has unsupported fields: \"\n                        f'{sorted(op.keys())!r}'\n                    )\n                document = op['document']\n                if not isinstance(document, dict):\n                    raise ValueError(\n                        f\"'document' is not a dict: {document!r}\"\n                    )\n                # Note: an empty dict is a valid document.\n\n            elif op_name == 'remove':\n                if set(op.keys()) != self._REMOVE_FIELDS:\n                    raise ValueError(\n                        f\"'remove' operation has unsupported fields: \"\n                        f'{sorted(op.keys())!r}'\n                    )\n                doc_id = op['doc_id']\n                # A positive integer is required. ``bool`` is a subclass of\n                # ``int``, so it is rejected explicitly.\n                if isinstance(doc_id, bool) or not isinstance(doc_id, int):\n                    raise ValueError(\n                        f\"'doc_id' is not a positive integer: {doc_id!r}\"\n                    )\n                if doc_id <= 0:\n                    raise ValueError(\n                        f\"'doc_id' is not a positive integer: {doc_id!r}\"\n                    )\n\n            else:\n                raise ValueError(f'Unknown operation: {op_name!r}')\n\n        return operations\n\n    def _resolve_next_id(self, table) -> int:\n        \"\"\"\n        Determine the next document ID to hand out.\n\n        The wrapper's own state takes precedence; otherwise the table's\n        state is used (its cached ``_next_id`` if any, else the highest ID\n        currently stored plus one). This is what makes direct\n        ``db.insert`` calls between batches visible to the wrapper without\n        caching a stale initial snapshot.\n        \"\"\"\n        # The next ID must be larger than every ID that is known to have\n        # been handed out or stored: the wrapper's own state, the table's\n        # cached counter (which direct ``db.insert`` calls advance) and the\n        # highest ID currently in the table. Taking the maximum is what\n        # keeps the sequence moving forward without reuse or rewind.\n        candidates = [1]\n        if self._next_id is not None:\n            candidates.append(self._next_id)\n        if table._next_id is not None:\n            candidates.append(table._next_id)\n        raw_table = table._read_table()\n        if raw_table:\n            candidates.append(\n                max(table.document_id_class(i) for i in raw_table.keys()) + 1\n            )\n        return max(candidates)\n===\n?? HANDOFF.md\n?? TASK_STAGE_1.md\n?? TASK_STAGE_2.md\n?? TASK_STAGE_3.md\n?? acceptance_public.py\n?? tests/test_journal.py\n?? tinydb/journal.py\n===\n__init__.py\nconftest.py\ntest_journal.py\ntest_middlewares.py\ntest_operations.py\ntest_queries.py\ntest_storages.py\ntest_tables.py\ntest_tinydb.py\ntest_utils.py\n"}