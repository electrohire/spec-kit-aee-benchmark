{"command": "sed -n 30,120p /testbed/src/cachetools/tagged.py | cut -c1-100", "exit_code": 0, "stderr": "", "stdout": "    return seen\n\n\nclass TaggedCache(LRUCache):\n    \"\"\"Bounded LRU cache whose entries carry deduplicated string tags.\n\n    Values are deep-copied on input (``put``) and output (``get``) so the\n    stored value is detached from caller objects. Tag memberships are\n    removed on replacement, invalidation, eviction, and ``del`` so LRU\n    eviction never leaves stale memberships.\n    \"\"\"\n\n    def __init__(self, maxsize):\n        _validate_maxsize(maxsize)\n        LRUCache.__init__(self, maxsize)\n        self._tags = {}\n        self._tag_index = {}\n\n    def put(self, key, value, tags=()):\n        \"\"\"Insert or replace ``key`` with a deep copy of ``value`` tagged by\n        ``tags`` (a finite iterable of strings, deduplicated, consumed once).\n\n        Invalid tags raise ValueError before any existing state changes.\n        Replacing an existing key drops its old tag memberships and refreshes\n        its LRU recency.\n        \"\"\"\n        tag_set = _normalize_tags(tags)\n        if key in self and key in self._tags:\n            self._drop_memberships(key, self._tags[key])\n        self[key] = copy.deepcopy(value)\n        self._tags[key] = frozenset(tag_set)\n        for tag in tag_set:\n            self._tag_index.setdefault(tag, set()).add(key)\n\n    def get(self, key, default=_MISSING):\n        \"\"\"Return a detached deep copy of the stored value for ``key``,\n        refreshing its LRU recency. Raises KeyError for missing keys when no\n        default is given.\"\"\"\n        if key in self:\n            value = self[key]  # refreshes recency via LRUCache.__getitem__\n            return copy.deepcopy(value)\n        if default is _MISSING:\n            raise KeyError(key)\n        return default\n\n    def invalidate(self, tag):\n        \"\"\"Remove all currently cached entries carrying ``tag``; return the\n        number removed.\"\"\"\n        return self._remove_tagged(self._tag_index.get(tag, ()))\n\n    def invalidate_many(self, tags, mode=\"any\"):\n        \"\"\"Remove entries matching ``tags`` and return the number of distinct\n        keys removed.\n\n        ``mode='any'`` removes the union (entries carrying at least one\n        requested tag); ``mode='all'`` removes entries carrying every\n        requested tag. An empty requested tag set removes zero entries in\n        either mode. Invalid ``mode`` or tags raise ValueError before any\n        mutation.\n        \"\"\"\n        if mode not in (\"any\", \"all\"):\n            raise ValueError(\"mode must be 'any' or 'all', got %r\" % (mode,))\n        tag_set = _normalize_tags(tags)\n        if not tag_set:\n            return 0\n        if mode == \"any\":\n            keys = set()\n            for tag in tag_set:\n                keys.update(self._tag_index.get(tag, ()))\n        else:\n            key_sets = [self._tag_index.get(tag, set()) for tag in tag_set]\n            keys = set(key_sets[0])\n            for ks in key_sets[1:]:\n                keys &= ks\n        return self._remove_tagged(keys)\n\n    def resize(self, maxsize):\n        \"\"\"Change the cache capacity in place. Invalid maxsize raises\n        ValueError before any mutation. Shrinking evicts least-recently-used\n        entries; growing does not evict. Surviving entries keep their LRU\n        order and any absolute expiry.\"\"\"\n        _validate_maxsize(maxsize)\n        current = self.maxsize\n        if maxsize < current:\n            while len(self) > maxsize:\n                self.popitem()\n        self.maxsize = maxsize\n\n    def popitem(self):\n        \"\"\"Remove and return the least-recently-used ``(key, value)`` pair,\n        dropping its tag memberships.\"\"\"\n"}