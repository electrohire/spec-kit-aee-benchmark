{"command": "cd /testbed && sed -n '198,260p' tests/test_tagged_m2.py; echo ===; sed -n '1,60p' tests/test_tagged.py", "exit_code": 0, "stderr": "", "stdout": "def test_put_rejects_generator_reuse_not_needed():\n    # a generator is a valid iterable; single consumption suffices\n    c = TaggedCache(4)\n    c.put('k', 1, (t for t in ['a', 'a', 'b']))\n    assert c.invalidate('a') == 1\n    assert c.invalidate('b') == 0\n    assert len(c) == 0\n\n\ndef test_detached_across_repeated_gets_and_puts():\n    c = TaggedCache(4)\n    value = {'l': [1, 2], 'd': {'n': [3]}}\n    c.put('k', value, ['t'])\n    v1 = c.get('k')\n    v1['l'].append(9)\n    v1['d']['n'].append(9)\n    v2 = c.get('k')\n    assert v2 == {'l': [1, 2], 'd': {'n': [3]}}\n    assert v1 is not v2\n    v2['l'].append(10)\n    assert c.get('k') == {'l': [1, 2], 'd': {'n': [3]}}\n    # replace with nested value; old external mutation must not leak\n    new = {'l': [1], 'd': {'n': [2]}}\n    c.put('k', new, ['t'])\n    new['l'].append(77)\n    assert c.get('k') == {'l': [1], 'd': {'n': [2]}}\n\n\ndef test_invalidate_many_mode_default_is_any():\n    c = TaggedCache(8)\n    c.put('a', 1, ['x'])\n    c.put('b', 2, ['x', 'y'])\n    assert c.invalidate_many(['y']) == 1\n    assert 'a' in c\n===\nimport pytest\n\nfrom cachetools import LRUCache\nfrom cachetools.tagged import TaggedCache\n\n\ndef test_basic_put_get():\n    c = TaggedCache(2)\n    c.put('a', 1, ['x'])\n    assert c.get('a') == 1\n    assert len(c) == 1\n    assert c.maxsize == 2\n    assert c.currsize == 1\n    assert 'a' in c\n\n\ndef test_get_missing_raises_keyerror():\n    c = TaggedCache(2)\n    with pytest.raises(KeyError):\n        c.get('nope')\n\n\ndef test_values_copied_on_input_and_output():\n    c = TaggedCache(2)\n    value = {'a': [1, 2]}\n    c.put('k', value, ['t'])\n    value['a'].append(3)\n    assert c.get('k') == {'a': [1, 2]}\n    got = c.get('k')\n    got['a'].append(99)\n    assert c.get('k') == {'a': [1, 2]}\n\n\ndef test_tags_deduplicated():\n    c = TaggedCache(4)\n    c.put('k', 1, ['b', 'a', 'b'])\n    assert c.invalidate('b') == 1\n    assert c.invalidate('a') == 0\n    assert len(c) == 0\n\n\ndef test_bare_string_tags_rejected_before_state_change():\n    c = TaggedCache(2)\n    c.put('a', 1, ['old'])\n    with pytest.raises(ValueError):\n        c.put('b', 2, 'ab')\n    assert 'b' not in c\n    assert c.invalidate('old') == 1\n    assert len(c) == 0\n\n\ndef test_nonstring_tag_rejected_before_state_change():\n    c = TaggedCache(2)\n    c.put('a', 1, ['old'])\n    with pytest.raises(ValueError):\n        c.put('a', 2, ['old', 1])\n    assert c.get('a') == 1\n    assert c.invalidate('old') == 1\n    assert len(c) == 0\n\n"}