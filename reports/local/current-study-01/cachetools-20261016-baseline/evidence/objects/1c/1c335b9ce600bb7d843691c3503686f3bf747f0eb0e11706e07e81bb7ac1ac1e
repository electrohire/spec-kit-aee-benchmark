ert len(c) == 2\n\n\ndef test_invalidate_many_distinct_keys():\n    c = TaggedCache(8)\n    c.put('a', 1, ['x', 'y'])\n    c.put('b', 2, ['x'])\n    c.put('c', 3, ['y'])\n    assert c.invalidate_many(['x', 'y', 'y']) == 3\n    assert len(c) == 0\n\n\ndef test_invalidate_many_bad_mode_rejected_before_mutation():\n    c = TaggedCache(4)\n    c.put('a', 1, ['x'])\n    with pytest.raises(ValueError):\n        c.invalidate_many(['x'], mode='ANY')\n    with pytest.raises(ValueError):\n        c.invalidate_many(['x'], mode=1)\n    assert len(c) == 1 and c.get('a') == 1\n\n\ndef test_invalidate_many_bad_tags_rejected_before_mutation():\n    c = TaggedCache(4)\n    c.put('a', 1, ['x'])\n    with pytest.raises(ValueError):\n        c.invalidate_many('xy')  # bare string\n"}