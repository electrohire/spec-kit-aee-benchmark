{"command": "cd /testbed && sed -n '85,150p' tests/test_tagged_m2.py", "exit_code": 0, "stderr": "", "stdout": "# ---------------- R05: resize ----------------\n\ndef test_resize_validation():\n    c = TaggedCache(4)\n    for bad in (0, -3, True, False, 1.5, '2', None):\n        with pytest.raises(ValueError):\n            c.resize(bad)\n    assert c.maxsize == 4\n\n\ndef test_resize_shrink_evicts_lru():\n    c = TaggedCache(4)\n    c.put('a', 1, ['t1'])\n    c.put('b', 2, ['t2'])\n    c.put('c', 3, ['t3'])\n    c.put('d', 4, ['t4'])\n    c.get('a')  # a -> MRU, so eviction order: b, c, d\n    c.resize(2)\n    assert c.maxsize == 2\n    assert 'a' in c and 'd' in c\n    assert 'b' not in c and 'c' not in c\n    # evicted entries' tags are cleaned up\n    assert c.invalidate('t2') == 0\n    assert c.invalidate('t3') == 0\n    assert c.invalidate('t1') == 1\n    assert c.invalidate('t4') == 1\n    assert len(c) == 0\n\n\ndef test_resize_shrink_preserves_lru_order():\n    c = TaggedCache(3)\n    c.put('a', 1, [])\n    c.put('b', 2, [])\n    c.put('c', 3, [])\n    c.get('a')  # order: b, c, a\n    c.resize(2)  # evicts b\n    assert 'b' not in c\n    c.put('d', 4, [])  # evicts c (next LRU), order: a, d\n    assert 'c' not in c\n    c.put('e', 5, [])  # evicts a\n    assert 'a' not in c and 'd' in c and 'e' in c\n\n\ndef test_resize_grow_does_not_evict():\n    c = TaggedCache(2)\n    c.put('a', 1, ['x'])\n    c.put('b', 2, ['y'])\n    c.resize(5)\n    assert c.maxsize == 5\n    assert len(c) == 2 and 'a' in c and 'b' in c\n\n\ndef test_resize_same_size_noop():\n    c = TaggedCache(3)\n    c.put('a', 1, [])\n    c.resize(3)\n    assert c.maxsize == 3 and len(c) == 1\n\n\ndef test_resize_failed_preserves_state():\n    c = TaggedCache(3)\n    c.put('a', 1, ['t'])\n    c.put('b', 2, [])\n    try:\n        c.resize(0)\n        raise SystemExit('expected ValueError')\n"}