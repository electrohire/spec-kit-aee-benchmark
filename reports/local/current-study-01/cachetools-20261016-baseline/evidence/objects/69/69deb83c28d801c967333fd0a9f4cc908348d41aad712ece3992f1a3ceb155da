{"command": "cd /testbed && sed -n '120,175p' src/cachetools/tagged.py; echo ===; sed -n '60,120p' tests/test_tagged.py", "exit_code": 0, "stderr": "", "stdout": "            self.__data[key] = new_value\n            self.__tags[key] = tag_tuple\n        for tag in tag_tuple:\n            self.__add_membership(tag, key)\n\n    def get(self, key):\n        \"\"\"Return a detached deep copy of the value stored under *key*.\n\n        Refreshes the LRU recency of *key*.  Raises ``KeyError`` for\n        missing keys.\n\n        \"\"\"\n        if key not in self.__data:\n            raise KeyError(key)\n        value = self.__data[key]  # refreshes recency via LRUCache.__getitem__\n        return copy.deepcopy(value)\n\n    def invalidate(self, tag):\n        \"\"\"Remove all currently cached entries carrying *tag*.\n\n        Returns the number of entries removed.\n\n        \"\"\"\n        if not isinstance(tag, str):\n            raise ValueError(\"tag must be a string, got %r\" % (tag,))\n        keys = list(self.__memberships.get(tag, ()))\n        for key in keys:\n            del self[key]\n        return len(keys)\n\n    def invalidate_many(self, tags, mode='any'):\n        \"\"\"Remove entries according to *mode* and return the number of\n        distinct keys removed.\n\n        With ``mode='any'`` (the default), entries carrying any of the\n        supplied tags are removed (the union).  With ``mode='all'``,\n        only entries carrying every supplied tag are removed.  An empty\n        tag iterable removes zero entries in either mode.  Invalid\n        *mode* or invalid *tags* raise ``ValueError`` before any\n        mutation.  *tags* may be a generator and is consumed exactly\n        once.\n\n        \"\"\"\n        if mode not in ('any', 'all'):\n            raise ValueError(\"mode must be 'any' or 'all', got %r\" % (mode,))\n        tag_tuple = _normalize_tags(tags)\n        if not tag_tuple:\n            return 0\n        if mode == 'any':\n            wanted = set(tag_tuple)\n            removed = set()\n            for tag in tag_tuple:\n                removed.update(self.__memberships.get(tag, ()))\n        else:\n            wanted = set(tag_tuple)\n            removed = set()\n===\n\n\ndef test_noniterable_tags_rejected():\n    c = TaggedCache(2)\n    with pytest.raises(ValueError):\n        c.put('a', 1, 123)\n    assert len(c) == 0\n\n\ndef test_generator_tags_accepted():\n    c = TaggedCache(4)\n    c.put('k', 1, (t for t in ['x', 'y']))\n    assert c.invalidate('x') == 1\n    assert c.invalidate('y') == 0\n\n\ndef test_maxsize_validation():\n    for bad in (0, -1, True, False, 2.5, '3', None):\n        with pytest.raises(ValueError):\n            TaggedCache(bad)\n\n\ndef test_invalid_replacement_preserves_recency():\n    c = TaggedCache(2)\n    c.put('a', 1, ['old'])\n    c.put('b', 2, [])\n    c.get('b')  # b becomes MRU\n    with pytest.raises(ValueError):\n        c.put('a', 2, ['old', 1])\n    # peek without refreshing recency (raw LRU storage)\n    assert c._TaggedCache__data._Cache__data['a'] == 1\n    assert c._TaggedCache__tags['a'] == ('old',)\n    c.put('c', 3, [])  # evicts LRU entry 'a'\n    assert 'a' not in c\n    assert 'b' in c\n    assert 'c' in c\n\n\ndef test_replacement_removes_old_tags():\n    c = TaggedCache(4)\n    c.put('a', 1, ['old'])\n    c.put('a', 2, ['new'])\n    assert c.invalidate('old') == 0\n    assert c.get('a') == 2\n    assert c.invalidate('new') == 1\n\n\ndef test_replacement_refreshes_recency():\n    c = TaggedCache(2)\n    c.put('a', 1, [])\n    c.put('b', 2, [])\n    c.put('a', 10, [])  # overwrite refreshes recency\n    c.put('c', 3, [])  # evicts 'b', not 'a'\n    assert 'a' in c\n    assert c.get('a') == 10\n    assert 'b' not in c\n\n\ndef test_replacement_refreshes_recency_with_tag_change():\n    c = TaggedCache(2)\n    c.put('a', 1, ['t'])\n"}