       self.__remove_memberships(key)\n        self.__tags.pop(key, None)\n\n    def __add_membership(self, tag, key):\n        self.__memberships.setdefault(tag, []).append(key)\n\n    def __remove_memberships(self, key):\n        for tag in self.__tags.get(key, ()):\n            members = self.__memberships.get(tag)\n            if members:\n                try:\n                    members.remove(key)\n                except ValueError:\n                    pass\n                if not members:\n                    del self.__memberships[tag]\nEOF\nPYTHONPATH=src:. python -c \"import cachetools.tagged; print('import ok')\"", "exit_code": 0, "stderr": "", "stdout": "import ok\n"}