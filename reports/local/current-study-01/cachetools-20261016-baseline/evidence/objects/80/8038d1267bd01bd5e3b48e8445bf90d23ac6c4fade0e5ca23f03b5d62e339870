{"command": "cd /testbed && cat > src/cachetools/tagged.py << 'EOF'\n\"\"\"Tagged cache implementation built on top of :class:`LRUCache`.\"\"\"\n\nimport copy\n\nfrom . import LRUCache\n\n__all__ = (\"TaggedCache\",)\n\n_marker = object()\n\n\ndef _normalize_tags(tags):\n    \"\"\"Validate and deduplicate *tags*, returning a tuple of strings.\n\n    A bare string is rejected, as are non-string entries.  The iterable\n    must be finite; any iteration error propagates to the caller.  The\n    iterable is consumed exactly once.\n\n    \"\"\"\n    if isinstance(tags, str):\n        raise ValueError(\"tags must be an iterable of strings, not a str\")\n    try:\n        iterator = iter(tags)\n    except TypeError as exc:\n        raise ValueError(\n            \"tags must be an iterable of strings, got %r\" % (tags,)\n        ) from exc\n    seen = set()\n    result = []\n    for tag in iterator:\n        if not isinstance(tag, str):\n            raise ValueError(\"tags must be an iterable of strings, got %r\" % (tag,))\n        if tag not in seen:\n            seen.add(tag)\n            result.append(tag)\n    return tuple(result)\n\n\ndef _validate_maxsize(maxsize):\n    \"\"\"Return *maxsize* if it is a positive integer (bool excluded),\n    otherwise raise ``ValueError``.\n\n    \"\"\"\n    if isinstance(maxsize, bool) or not isinstance(maxsize, int):\n        raise ValueError(\"maxsize must be a positive integer, got %r\" % (maxsize,))\n    if maxsize < 1:\n        raise ValueError(\"maxsize must be a positive integer, got %r\" % (maxsize,))\n    return maxsize\n\n\nclass _TaggedLRUCache(LRUCache):\n    \"\"\"LRUCache that reports evicted keys to its owner.\"\"\"\n\n    def __init__(self, maxsize, on_evict):\n        LRUCache.__init__(self, maxsize)\n        self._on_evict = on_evict\n\n    def popitem(self):\n        key, value = LRUCache.popitem(self)\n        self._on_evict(key)\n        return key, value\n\n\nclass TaggedCache:\n    \"\"\"A tag-aware bounded cache backed by :class:`LRUCache`.\n\n    Values are stored as detached deep copies and are copied on input.\n    Each entry costs exactly one capacity slot regardless of object\n    size.  Keys must be hashable; tags must be strings.\n\n    \"\"\"\n\n    def __init__(self, maxsize):\n        self.__maxsize = _validate_maxsize(maxsize)\n        # key -> tuple of tags, kept in sync with self.__data\n        self.__tags = {}\n        # tag -> list of keys, kept in sync with self.__data\n        self.__memberships = {}\n        self.__data = _TaggedLRUCache(self.__maxsize, self.__evicted)\n\n    @property\n    def maxsize(self):\n        \"\"\"The maximum size of the cache.\"\"\"\n        return self.__maxsize\n\n    @property\n    def currsize(self):\n        \"\"\"The current number of entries in the cache.\"\"\"\n        return len(self.__data)\n\n    def __len__(self):\n        return len(self.__data)\n\n    def __contains__(self, key):\n        return key in self.__data\n\n    def put(self, key, value, tags=()):\n        \"\"\"Insert or replace *key* with a deep copy of *value*.\n\n        *tags* must be a finite iterable of strings (generators are\n        accepted and consumed exactly once); duplicate tags are removed\n        while preserving first-seen order.  Overwriting an existing key\n        replaces its tag memberships and refreshes its LRU recency,\n        making it the most-recently-used entry.  Invalid input (bad tags\n        or an unhashable key) raises before any existing state is\n        changed.\n\n        \"\"\"\n        tag_tuple = _normalize_tags(tags)\n        # touching the key validates hashability before any mutation\n        existing = key in self.__data\n        new_value = copy.deepcopy(value)\n        if existing:\n            # drop old tag memberships before the LRU update so an\n            # eviction can never resurrect stale ones\n            self.__remove_memberships(key)\n            self.__data[key] = new_value\n            self.__tags[key] = tag_tuple\n        else:\n            self.__data[key] = new_value\n            self.__tags[key] = tag_tuple\n        for tag in tag_tuple:\n            self.__add_membership(tag, key)\n\n    def get(self, key):\n        \"\"\"Return a detached deep copy of the value stored under *key*.\n\n        Refreshes the LRU recency of *key*.  Raises ``KeyError`` for\n        missing keys.\n\n        \"\"\"\n        if key not in self.__data:\n            raise KeyError(key)\n        value = self.__data[key]  # refreshes recency via LRUCache.__getitem__\n        return copy.deepcopy(value)\n\n    def invalidate(self, tag):\n        \"\"\"Remove all currently cached entries carrying *tag*.\n\n        Returns the number of entries removed.\n\n        \"\"\"\n        if not isinstance(tag, str):\n            raise ValueError(\"tag must be a string, got %r\" % (tag,))\n        keys = list(self.__memberships.get(tag, ()))\n        for key in keys:\n            del self[key]\n        return len(keys)\n\n    def invalidate_many(self, tags, mode='any'):\n        \"\"\"Remove entries according to *mode* and return the number of\n        distinct keys removed.\n\n        With ``mode='any'`` (the default), entries carrying any of the\n        supplied tags are removed (the union).  With ``mode='all'``,\n        only entries carrying every supplied tag are removed.  An empty\n        tag iterable removes zero entries in either mode.  Invalid\n        *mode* or invalid *tags* raise ``ValueError`` before any\n        mutation.  *tags* may be a generator and is consumed exactly\n        once.\n\n        \"\"\"\n        if mode not in ('any', 'all'):\n            raise ValueError(\"mode must be 'any' or 'all', got %r\" % (mode,))\n        tag_tuple = _normalize_tags(tags)\n        if not tag_tuple:\n            return 0\n        if mode == 'any':\n            wanted = set(tag_tuple)\n            removed = set()\n            for tag in tag_tuple:\n                removed.update