{"command": "cd /testbed && PYTHONPATH=src:. python - << 'EOF'\nfrom cachetools.tagged import TaggedCache\n\n# maxsize=1 replacement\n c = None\nc = TaggedCache(1)\nc.put('a', 1, ['t'])\nc.put('a', 2, ['u'])\nassert c.get('a') == 2 and c.invalidate('t') == 0 and c.invalidate('u') == 1 and len(c) == 0\n\n# eviction during replacement of a *different* key cleans memberships\nc = TaggedCache(2)\nc.put('a', 1, ['x'])\nc.put('b', 2, ['y'])\nc.put('b', 3, ['z'])   # replace b; no eviction\nassert c.invalidate('y') == 0 and c.invalidate('z') == 1\n\n# evict via new key, then reuse evicted key with no tag\nc = TaggedCache(2)\nc.put('a', 1, ['t'])\nc.put('b', 2, [])\nc.put('c', 3, [])  # evicts 'a'\nassert c.invalidate('t') == 0\nc.put('a', 4, ['t'])\nassert c.invalidate('t') == 1  # only the new 'a'\n\n# invalidate with non-string raises, state untouched\nc = TaggedCache(2)\nc.put('a', 1, ['x'])\ntry:\n    c.invalidate(None)\n    raise SystemExit('expected ValueError')\nexcept ValueError:\n    pass\nassert c.get('a') == 1 and len(c) == 1\n\n# default tags=() works, empty tags\n c = TaggedCache(3)\nc.put('k', {'v': 1})\nassert c.get('k') == {'v': 1}\nassert c.invalidate('anything') == 0\n\n# repr/len/currsize\nassert len(c) == 1 and c.currsize == 1 and 'maxsize=3' in repr(c)\n\n# get refreshes recency even when evicting later\nc = TaggedCache(2)\nc.put('a', 1, [])\nc.put('b', 2, [])\nc.get('a')\nc.put('c', 3, [])\nassert 'a' in c and 'b' not in c\n\n# pop semantics\nc.put('d', 4, [])\nassert c.pop('d') == 4 and 'd' not in c\nassert c.pop('d', 0) == 0\ntry:\n    c.pop('d'); raise SystemExit('expected KeyError')\nexcept KeyError:\n    pass\n\n# unhashable key\ntry:\n    c.put({'x': 1}, 1, [])\n    raise SystemExit('expected error')\nexcept (TypeError, ValueError):\n    pass\n\n# deep copy on input\nv = {'l': [1, 2]}\nc.put('e', v, [])\nv['l'].append(3)\nassert c.get('e') == {'l': [1, 2]}\n\nprint('all edge checks passed')\nEOF", "exit_code": 1, "stderr": "  File \"<stdin>\", line 4\n    c = None\nIndentationError: unexpected indent\n", "stdout": ""}