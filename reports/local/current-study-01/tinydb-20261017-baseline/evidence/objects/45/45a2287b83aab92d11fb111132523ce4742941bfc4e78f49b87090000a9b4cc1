bool) or not isinstance(doc_id, int):\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n            if doc_id <= 0:\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n\n    @classmethod\n    def _validate_operations(cls, operations: Any) -> None:\n        \"\"\"\n        Structurally validate a whole batch of operations.\n\n        Raises :class:`ValueError` for non-list input or for any\n        malformed operation. No state is modified.\n        \"\"\"\n\n        if not isinstance(operations, list):\n            raise ValueError(\n                'operations must be a list of operation dicts, got {!r}'.format(\n                    type(operations).__name__\n                )\n            )\n        for operation in operations:\n            cls._validate_operation(operation)\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def preview(self, operations: list) -> list[int]:\n        \"\"\"\n        Simulate a batch and return the IDs ``apply`` would produce.\n\n        The simulation is performed on a detached copy of the current\n        table data: no data is written, no document IDs are consumed,\n        and no caches are touched. In particular, a preview does not\n        change the next ID that a subsequent insert (via ``apply`` or\n        via a direct ``db.insert``) will receive, even if the previewed\n        batch errors out.\n\n        The returned list is a new, detached list on every call; mutating\n        a previously returned list has no effect on later previews or on\n        any internal writer state.\n\n        :param operations: a list of operation dictionaries (same format\n            as for :meth:`apply`)\n        :returns: a new list of the IDs that a successful ``apply`` of\n            the same operations would return\n        :raises ValueError: if any operation is malformed or if a remove\n            targets a missing document ID\n        \"\"\"\n\n        # Validate structurally before touching anything.\n        self._validate_operations(operations)\n\n        table = self._db.table(self._table_name)\n\n        # Work on a deep copy of the current table data so that the real\n        # table (and its query cache) is never touched.\n        data = self._db.storage.read()\n        raw = data.get(self._table_name, {}) if data else {}\n        # Storage may keep document IDs as strings (e.g. JSON file);\n        # normalise them to integers for the simulation.\n        sim = {int(k): copy.deepcopy(v) for k, v in raw.items()}\n\n        # Determine the next ID exactly like the table handle would\n        # (see ``Table._get_next_id``), without modifying the handle's\n        # counter: use the handle's cached counter when available,\n        # otherwise fall back to the maximum ID currently in use.\n        if table._next_id is not None:\n            next_id = table._next_id\n        else:\n            next_id = max(sim) + 1 if sim else 1\n\n        inserted_ids: list[int] = []\n        for operation in operations:\n            if operation['op'] == 'insert':\n                sim[next_id] = copy.deepcopy(dict(operation['document']))\n                inserted_ids.append(next_id)\n                next_id += 1\n            else:  # operation['op'] == 'remove'\n                doc_id = operation['doc_id']\n                if doc_id not in sim:\n                    raise ValueError(\n                        'Document with ID {} does not exist'.format(doc_id)\n                    )\n                del sim[doc_id]\n\n"}