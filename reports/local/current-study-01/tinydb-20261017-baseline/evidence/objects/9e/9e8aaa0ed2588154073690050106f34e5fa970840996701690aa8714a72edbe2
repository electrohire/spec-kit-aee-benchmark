{"command": "sed -n '150,200p' /testbed/tests/test_journal.py; echo ===; grep -n \"def test\" /testbed/tests/test_journal.py | wc -l; grep -c \"def test\" /testbed/tests/test_journal.py", "exit_code": 0, "stderr": "", "stdout": "\n\ndef test_stale_query_cache_cleared_on_rollback(env):\n    db, w = env\n    db.insert({'x': 1})\n    table = db.table('_default')\n    q = where(\"x\") == 1\n    assert table.search(q) == [table.get(doc_id=1)]\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    # The cached result must not contain the rolled-back insert\n    assert [d.doc_id for d in table.search(q)] == [1]\n\n\ndef test_other_tables_unaffected_by_rollback(env):\n    db, w = env\n    other = db.table('other')\n    other.insert({'y': 1})\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    assert [d['y'] for d in other.all()] == [1]\n    assert len(db) == 0\n\n\ndef test_id_sequence_restored_after_rollback(env):\n    db, w = env\n    db.insert({'x': 1})\n    db.insert({'x': 2})\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 3}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    # The failed batch must not have consumed the next ID\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n\n\n# ---------------------------------------------------------------- R03\n\ndef test_ordinary_api_still_works(env):\n    db, w = env\n    assert db.insert({'x': 1}) == 1\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert db.insert({'x': 3}) == 3\n    assert [d['x'] for d in db.all()] == [1, 2, 3]\n===\n43\n43\n"}