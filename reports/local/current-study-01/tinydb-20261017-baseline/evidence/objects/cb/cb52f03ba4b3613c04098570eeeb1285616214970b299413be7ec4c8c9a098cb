operation is malformed.\n        \"\"\"\n\n        if not isinstance(operation, Mapping):\n            raise ValueError(\n                'Each operation must be a dict, got {!r}'.format(\n                    type(operation).__name__\n                )\n            )\n\n        op = operation.get('op')\n        if op not in cls._KNOWN_OPS:\n            raise ValueError(\n                'Unknown operation {!r}; expected one of {}'.format(\n                    op, list(cls._KNOWN_OPS)\n                )\n            )\n\n        if op == 'insert':\n            if 'document' not in operation:\n                raise ValueError(\"'insert' operation requires a 'document' key\")\n            document = operation['document']\n            if not isinstance(document, Mapping):\n                raise ValueError(\n                    \"'insert' operation 'document' must be a dict, got {!r}\".format(\n                        type(document).__name__\n                    )\n                )\n        elif op == 'remove':\n            if 'doc_id' not in operation:\n                raise ValueError(\"'remove' operation requires a 'doc_id' key\")\n            doc_id = operation['doc_id']\n            if isinstance(doc_id, bool) or not isinstance(doc_id, int):\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n            if doc_id <= 0:\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def apply(self, operations: list) -> list[int]:\n        \"\"\"\n        Apply a batch of operations to the default table atomically.\n\n        Supported operations:\n\n        - ``{'op': 'insert', 'document': <dict>}`` -- insert a new\n          document; its ID is appended to the returned list.\n        - ``{'op': 'remove', 'doc_id': <positive int>}`` -- remove the\n          document with the given ID; the ID must exist, otherwise the\n          whole batch is rolled back.\n\n        :param operations: a list of operation dictionaries\n        :returns: a list of the IDs of all documents inserted by this\n            batch (in insertion order); removes do not add results\n        :raises ValueError: if any operation is malformed or if a remove\n            targets a missing document ID\n        \"\"\"\n\n        if not isinstance(operations, list):\n            raise ValueError(\n                'operations must be a list of operation dicts, got {!r}'.format(\n                    type(operations).__name__\n                )\n            )\n\n        # Validate the whole batch up front so that no partial state is\n        # ever created for syntactically invalid batches.\n        for operation in operations:\n            self._validate_operation(operation)\n\n        table = self._db.table(self._table_name)\n\n        # Snapshot the complete database state (which includes the\n        # default table) before touching anything. A deep copy is used\n        # so that later mutations of the live data cannot affect the\n        # snapshot.\n        snapshot = copy.deepcopy(self._db.storage.read())\n\n        # Remember the table's internal ID counter so it can be restored\n        # on rollback.\n        prev_next_id = table._next_id\n\n        inserted_ids: list[int] = []\n\n        try:\n            for operation in operations:\n                if operation['op'] == 'insert':\n                    # Deep-copy the document so neither the database nor\n                    # the returned data can alias the caller's input.\n                    document = copy.deepcopy(dict(operation['document']))\n\n                    doc_id = table