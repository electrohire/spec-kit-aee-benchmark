{"command": "wc -l /testbed/tinydb/journal.py; head -n 60 /testbed/tinydb/journal.py; echo ===TESTS===; ls /testbed/tests; wc -l /testbed/tests/test_journal.py 2>/dev/null", "exit_code": 0, "stderr": "", "stdout": "342 /testbed/tinydb/journal.py\n\"\"\"\nThis module provides :class:`BatchWriter`, a small batch/journal layer on\ntop of an existing :class:`~tinydb.TinyDB` instance.\n\nIt does not modify the wrapped database's ordinary APIs; it simply applies\nlists of operations to the database's *default* table in an atomic way.\n\"\"\"\n\nimport copy\nfrom collections.abc import Mapping\nfrom typing import Any, Optional\n\nfrom .database import TinyDB\n\n__all__ = ('BatchWriter',)\n\n\nclass BatchWriter:\n    \"\"\"\n    Apply batches of operations to a TinyDB default table atomically.\n\n    A ``BatchWriter`` wraps an existing :class:`~tinydb.TinyDB` instance\n    and exposes an :meth:`apply` method that takes a list of operation\n    dictionaries::\n\n        writer = BatchWriter(db)\n        doc_ids = writer.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 1},\n        ])\n\n    as well as a :meth:`preview` method that simulates a batch and returns\n    the IDs that ``apply`` would produce without changing any data or\n    consuming any IDs.\n\n    The batch is applied sequentially. If any operation fails (for\n    example a remove targeting a document ID that does not exist), the\n    complete pre-batch state of the default table is restored before the\n    error is re-raised, so a batch either fully succeeds or has no\n    effect at all.\n\n    .. note::\n\n        A previously generated note claimed that ``preview`` may consume\n        IDs and that boolean document IDs are accepted. That note is\n        superseded: ``preview`` never consumes IDs (see\n        :meth:`preview`) and boolean ``doc_id`` values are rejected\n        because ``bool`` is a subclass of ``int`` but not a valid\n        document ID.\n    \"\"\"\n\n    #: The set of operation names understood by :meth:`apply`\n    _KNOWN_OPS = ('insert', 'remove')\n\n    def __init__(self, db: TinyDB) -> None:\n        \"\"\"\n        Create a batch writer for the given database.\n\n        :param db: the TinyDB instance to wrap\n        \"\"\"\n===TESTS===\n__init__.py\nconftest.py\ntest_journal.py\ntest_middlewares.py\ntest_operations.py\ntest_queries.py\ntest_storages.py\ntest_tables.py\ntest_tinydb.py\ntest_utils.py\n503 /testbed/tests/test_journal.py\n"}