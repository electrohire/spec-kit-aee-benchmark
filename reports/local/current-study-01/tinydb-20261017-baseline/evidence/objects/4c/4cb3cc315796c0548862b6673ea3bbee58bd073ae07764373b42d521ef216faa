{"command": "cd /testbed && cat > tinydb/journal.py <<'PYEOF'\n\"\"\"\nThis module provides :class:`BatchWriter`, a small batch/journal layer on\ntop of an existing :class:`~tinydb.TinyDB` instance.\n\nIt does not modify the wrapped database's ordinary APIs; it simply applies\nlists of operations to the database's *default* table in an atomic way.\n\"\"\"\n\nimport copy\nfrom collections.abc import Mapping\nfrom typing import Any, Optional\n\nfrom .database import TinyDB\n\n__all__ = ('BatchWriter',)\n\n\nclass BatchWriter:\n    \"\"\"\n    Apply batches of operations to a TinyDB default table atomically.\n\n    A ``BatchWriter`` wraps an existing :class:`~tinydb.TinyDB` instance\n    and exposes an :meth:`apply` method that takes a list of operation\n    dictionaries::\n\n        writer = BatchWriter(db)\n        doc_ids = writer.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 1},\n        ])\n\n    as well as a :meth:`preview` method that simulates a batch and returns\n    the IDs that ``apply`` would produce without changing any data or\n    consuming any IDs.\n\n    The batch is applied sequentially. If any operation fails (for\n    example a remove targeting a document ID that does not exist), the\n    complete pre-batch state of the default table is restored before the\n    error is re-raised, so a batch either fully succeeds or has no\n    effect at all.\n\n    .. note::\n\n        A previously generated note claimed that ``preview`` may consume\n        IDs and that boolean document IDs are accepted. That note is\n        superseded: ``preview`` never consumes IDs (see\n        :meth:`preview`) and boolean ``doc_id`` values are rejected\n        because ``bool`` is a subclass of ``int`` but not a valid\n        document ID.\n    \"\"\"\n\n    #: The set of operation names understood by :meth:`apply`\n    _KNOWN_OPS = ('insert', 'remove')\n\n    def __init__(self, db: TinyDB) -> None:\n        \"\"\"\n        Create a batch writer for the given database.\n\n        :param db: the TinyDB instance to wrap\n        \"\"\"\n        self._db = db\n        self._table_name = db.default_table_name\n\n    # ------------------------------------------------------------------\n    # Validation helpers\n    # ------------------------------------------------------------------\n\n    @classmethod\n    def _validate_operation(cls, operation: Any) -> None:\n        \"\"\"\n        Structurally validate a single operation dictionary.\n\n        This happens *before* any change is committed, so malformed\n        batches can never leave partial state behind.\n\n        Raises :class:`ValueError` if the operation is malformed.\n        \"\"\"\n\n        if not isinstance(operation, Mapping):\n            raise ValueError(\n                'Each operation must be a dict, got {!r}'.format(\n                    type(operation).__name__\n                )\n            )\n\n        op = operation.get('op')\n        if op not in cls._KNOWN_OPS:\n            raise ValueError(\n                'Unknown operation {!r}; expected one of {}'.format(\n                    op, list(cls._KNOWN_OPS)\n                )\n            )\n\n        if op == 'insert':\n            if 'document' not in operation:\n                raise ValueError(\"'insert' operation requires a 'document' key\")\n            document = operation['document']\n            if not isinstance(document, Mapping):\n                raise ValueError(\n                    \"'insert' operation 'document' must be a dict, got \"\n                    '{!r}'.format(type(document).__name__)\n                )\n        elif op == 'remove':\n            if 'doc_id' not in operation:\n                raise ValueError(\"'remove' operation requires a 'doc_id' key\")\n            doc_id = operation['doc_id']\n            # ``bool`` is a subclass of ``int`` but is explicitly not a\n            # valid document ID.\n            if isinstance(doc_id, bool) or not isinstance(doc_id, int):\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n            if doc_id <= 0:\n                raise ValueError(\n                    \"'remove' operation 'doc_id' must be a positive integer, \"\n                    'got {!r}'.format(doc_id)\n                )\n\n    @classmethod\n    def _validate_operations(cls, operations: Any) -> None:\n        \"\"\"\n        Structurally validate a whole batch of operations.\n\n        Raises :class:`ValueError` for non-list input or for any\n        malformed operation. No state is modified.\n        \"\"\"\n\n        if not isinstance(operations, list):\n            raise ValueError(\n                'operations must be a list of operation dicts, got {!r}'.format(\n                    type(operations).__name__\n                )\n            )\n        for operation in operations:\n            cls._validate_operation(operation)\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def preview(self, operations: list) -> list[int]:\n        \"\"\"\n        Simulate a batch and return the IDs ``apply`` would produce.\n\n        The simulation is performed on a detached copy of the current\n        table data: no data is written, no document IDs are consumed,\n        and no caches are touched. In particular, a preview does not\n        change the next ID that a subsequent insert (via ``apply`` or\n        via a direct ``db.insert``) will receive, even if the previewed\n        batch errors out.\n\n        The returned list is a new, detached list on every call; mutating\n        a previously returned list has no effect on later previews or on\n        any internal writer state.\n\n        :param operations: a list of operation dictionaries (same format\n            as for :meth:`apply`)\n        :returns: a new list of the IDs that a successful ``apply`` of\n            the same operations would return\n        :raises ValueError: if any operation is malformed or if a remove\n            targets a missing document ID\n        \"\"\"\n\n        # Validate structurally before touching anything.\n        self._validate_operations(operations)\n\n        table = self._db.table(self._table_name)\n\n        # Work on a deep copy of the current table data so that the real\n        # table (and its query cache) is never touched.\n        data = self._db.storage.read()\n        sim = copy.deepcopy(data.get(self._table_name, {})) if data else {}\n\n        # The next ID without relying on (or modifying) the table's\n        # internal ``_next_id`` counter: it is the smallest positive\n        # integer that is not currently used.\n        next_id = 1\n        while next_id in sim:\n            next_id += 1\n\n        inserted_ids: list[int] = []\n        for operation in operations:\n            if operation['op'] == 'insert':\n                sim[next_id] = copy.deepcopy(dict(operation['document']))\n                inserted_ids.append(next_id)\n                next_id += 1\n            else:  # operation['op'] == 'remove'\n                doc_id = operation['doc_id']\n                if doc_id not in sim:\n                    raise ValueError(\n                        'Document with ID {} does not exist'.format(doc_id)\n                    )\n                del sim[doc_id]\n\n        # Return a fresh, detached list.\n        return list(inserted_ids)\n\n    def apply(self, operations: list) -> list[int]:\n        \"\"\"\n        Apply a batch of operations to the default table atomically.\n\n        Supported operations:\n\n        - ``{'op': 'insert', 'document': <dict>}`` -- insert a new\n          document; its ID is appended to the returned list.\n        - ``{'op': 'remove', 'doc_id': <positive int>}`` -- remove the\n          document with the given ID; the ID must exist, otherwise the\n          whole batch is rolled back.\n\n        A successful batch advances the table's next-insertion-ID state\n        (which is persisted via the underlying storage), so subsequent\n        inserts -- via ``apply`` or direct ``db.insert`` -- continue the\n        ID sequence without reuse or rewind, even across remove\n        operations. A failed batch consumes no IDs.\n\n        :param operations: a list of operation dictionaries\n        :returns: a new list of the IDs of all documents inserted by\n            this batch (in insertion order); removes do not add results\n        :raises ValueError: if any operation is malformed or if a remove\n            targets a missing document ID\n        \"\"\"\n\n        # Validate the whole batch structurally up front so that no\n        # partial state is ever created for invalid batches.\n        self._validate_operations(operations)\n\n        table = self._db.table(self._table_name)\n\n        # Snapshot the complete database state (which includes the\n        # default table) before touching anything. A deep copy is used\n        # so that later mutations of the live data cannot affect the\n        # snapshot.\n        snapshot = copy.deepcopy(self._db.storage.read())\n\n        # Remember the table's internal ID counter so it can be restored\n        # on rollback.\n        prev_next_id = table._next_id\n\n        inserted_ids: list[int] = []\n\n        try:\n            for operation in operations:\n                if operation['op'] == 'insert':\n                    # Deep-copy the document so neither the database nor\n                    # the returned data can alias the caller's input.\n                    document = copy.deepcopy(dict(operation['document']))\n\n                    doc_id = table._get_next_id()\n\n                    def _insert_updater(\n                        t: dict, _id: int = doc_id, _doc: dict = document\n                    ) -> None:\n                        if _id in t:\n                            raise ValueError(\n                                'Document with ID {} already exists'.format(_id)\n                            )\n                        t[_id] = _doc\n\n                    table._update_table(_insert_updater)\n                    inserted_ids.append(doc_id)\n\n                else:  # operation['op'] == 'remove'\n                    doc_id = operation['doc_id']\n\n                    def _remove_updater(t: dict, _id: int = doc_id) -> None:\n                        if _id not in t:\n                            raise ValueError(\n                                'Document with ID {} does not exist'.format(_id)\n                            )\n                        del t[_id]\n\n                    table._update_table(_remove_updater)\n        except Exception:\n            # Roll back to the complete pre-batch state.\n            self._rollback(snapshot)\n\n            # Restore the table's internal ID counter so that future\n            # inserts continue from the pre-batch ID sequence (a failed\n            # batch must not consume IDs).\n            table._next_id = prev_next_id\n\n            # Make sure previously acquired table handles see the\n            # rolled-back state (their query caches may still hold\n            # results computed from the failed batch).\n            table.clear_cache()\n\n            raise\n\n        # On success the table's ``_next_id`` now points past all IDs\n        # used by this batch. ``_update_table`` already persisted the\n        # table data (which determines the next ID for a fresh table\n        # handle), and the in-memory counter keeps the live handle in\n        # sync, so subsequent inserts -- via ``apply`` or direct\n        # ``db.insert`` -- continue the sequence without reuse or\n        # rewind.\n\n        # Previously acquired handles must reflect the new state. Table\n        # reads always go through the storage, but the query cache may\n        # still hold stale results.\n        table.clear_cache()\n\n        # Return a fresh, detached list.\n        return list(inserted_ids)\n\n    # ------------------------------------------------------------------\n    # Rollback\n    # ------------------------------------------------------------------\n\n    def _rollback(self, snapshot: Optional[dict]) -> None:\n        \"\"\"\n        Restore the default table to its pre-batch state.\n\n        :param snapshot: a deep copy of the database data taken before\n            the batch was applied (may be ``None`` for an empty database)\n        \"\"\"\n\n        current = self._db.storage.read()\n        if current is None:\n            current = {}\n\n        # Determine whether the default table existed before the batch.\n        if snapshot is None or self._table_name not in snapshot:\n            # It did not exist: remove it from the current data.\n            current.pop(self._table_name, None)\n            if not current:\n                # Write an empty dict rather than None: storages are not\n                # guaranteed to accept ``None``.\n                self._db.storage.write({})\n            else:\n                self._db.storage.write(current)\n        else:\n            # It existed: restore its pre-batch contents.\n            current[self._table_name] = copy.deepcopy(\n                snapshot[self._table_name]\n            )\n            self._db.storage.write(current)\nPYEOF\npython -c \"import ast; ast.parse(open('/testbed/tinydb/journal.py').read()); print('syntax ok')\"", "exit_code": 0, "stderr": "", "stdout": "syntax ok\n"}