{"command": "sed -n '280,342p' /testbed/tinydb/journal.py; echo ===TESTS200-330===; sed -n '200,330p' /testbed/tests/test_journal.py", "exit_code": 0, "stderr": "", "stdout": "            # Roll back to the complete pre-batch state.\n            self._rollback(snapshot)\n\n            # Restore the table's internal ID counter so that future\n            # inserts continue from the pre-batch ID sequence (a failed\n            # batch must not consume IDs).\n            table._next_id = prev_next_id\n\n            # Make sure previously acquired table handles see the\n            # rolled-back state (their query caches may still hold\n            # results computed from the failed batch).\n            table.clear_cache()\n\n            raise\n\n        # On success the table's ``_next_id`` now points past all IDs\n        # used by this batch. ``_update_table`` already persisted the\n        # table data (which determines the next ID for a fresh table\n        # handle), and the in-memory counter keeps the live handle in\n        # sync, so subsequent inserts -- via ``apply`` or direct\n        # ``db.insert`` -- continue the sequence without reuse or\n        # rewind.\n\n        # Previously acquired handles must reflect the new state. Table\n        # reads always go through the storage, but the query cache may\n        # still hold stale results.\n        table.clear_cache()\n\n        # Return a fresh, detached list.\n        return list(inserted_ids)\n\n    # ------------------------------------------------------------------\n    # Rollback\n    # ------------------------------------------------------------------\n\n    def _rollback(self, snapshot: Optional[dict]) -> None:\n        \"\"\"\n        Restore the default table to its pre-batch state.\n\n        :param snapshot: a deep copy of the database data taken before\n            the batch was applied (may be ``None`` for an empty database)\n        \"\"\"\n\n        current = self._db.storage.read()\n        if current is None:\n            current = {}\n\n        # Determine whether the default table existed before the batch.\n        if snapshot is None or self._table_name not in snapshot:\n            # It did not exist: remove it from the current data.\n            current.pop(self._table_name, None)\n            if not current:\n                # Write an empty dict rather than None: storages are not\n                # guaranteed to accept ``None``.\n                self._db.storage.write({})\n            else:\n                self._db.storage.write(current)\n        else:\n            # It existed: restore its pre-batch contents.\n            current[self._table_name] = copy.deepcopy(\n                snapshot[self._table_name]\n            )\n            self._db.storage.write(current)\n===TESTS200-330===\n    assert [d['x'] for d in db.all()] == [1, 2, 3]\n    db.remove(where(\"x\") == 2)\n    assert [d['x'] for d in db.all()] == [1, 3]\n    assert len(db) == 2\n    assert db.search(where(\"x\") == 3)[0].doc_id == 3\n\n\ndef test_no_aliasing_of_input(env):\n    db, w = env\n    doc = {'x': 1, 'nested': {'a': [1, 2]}}\n    w.apply([{'op': 'insert', 'document': doc}])\n    # Mutating the caller's input after apply must not affect the DB\n    doc['x'] = 999\n    doc['nested']['a'].append(3)\n    stored = db.get(doc_id=1)\n    assert stored['x'] == 1\n    assert stored['nested']['a'] == [1, 2]\n\n\ndef test_no_aliasing_of_stored_data(env):\n    db, w = env\n    doc = {'x': 1, 'nested': {'a': [1, 2]}}\n    w.apply([{'op': 'insert', 'document': doc}])\n    # Mutating the stored document must not affect the caller's input\n    stored = db.get(doc_id=1)\n    stored['nested']['a'].append(3)\n    assert doc['nested']['a'] == [1, 2]\n\n\ndef test_input_not_moved_into_db(env):\n    db, w = env\n    doc = {'x': 1}\n    w.apply([{'op': 'insert', 'document': doc}])\n    stored = db.get(doc_id=1)\n    assert stored is not doc\n    assert stored['x'] == 1\n\n\ndef test_preexisting_documents_survive_batches(env):\n    db, w = env\n    db.insert({'x': 1})\n    db.insert({'x': 2})\n    w.apply([{'op': 'insert', 'document': {'x': 3}}])\n    w.apply([{'op': 'remove', 'doc_id': 1}])\n    assert [d['x'] for d in db.all()] == [2, 3]\n\n\n# ---------------------------------------------------------------- R04\n\ndef test_bool_doc_id_rejected(env):\n    db, w = env\n    for bad in (True, False):\n        with pytest.raises(ValueError):\n            w.apply([{'op': 'remove', 'doc_id': bad}])\n        with pytest.raises(ValueError):\n            w.preview([{'op': 'remove', 'doc_id': bad}])\n    assert len(db) == 0\n\n\ndef test_preview_bool_doc_id_rejected(env):\n    db, w = env\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'remove', 'doc_id': True}])\n    assert len(db) == 1\n\n\n@pytest.mark.parametrize('bad', [\n    {'op': 'insert', 'document': {}},          # empty dict IS accepted\n])\ndef test_empty_document_accepted(env, bad):\n    db, w = env\n    assert w.apply([bad]) == [1]\n    assert w.preview([{'op': 'insert', 'document': {}}]) == [2]\n\n\n@pytest.mark.parametrize('bad', [\n    {'op': 'insert', 'document': [1]},         # non-dict document\n    {'op': 'insert', 'document': 'x'},         # non-dict document\n    {'op': 'insert', 'document': 42},          # non-dict document\n    'not-a-dict',                              # non-dict operation\n    None,                                      # non-dict operation\n    {'op': 'insert'},                          # missing document\n    {'op': 'remove'},                          # missing doc_id\n    {'op': 'nope', 'doc_id': 1},               # unknown op\n])\ndef test_structural_validation_before_commit(env, bad):\n    db, w = env\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 2}}, bad])\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'insert', 'document': {'x': 2}}, bad])\n    # Nothing committed\n    assert [d['x'] for d in db.all()] == [1]\n    # And no ID consumed\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [2]\n\n\ndef test_non_list_operations_rejected(env):\n    db, w = env\n    for bad in ({'op': 'insert', 'document': {}}, ('op',), 'insert', 42):\n        with pytest.raises(ValueError):\n            w.apply(bad)  # type: ignore[arg-type]\n        with pytest.raises(ValueError):\n            w.preview(bad)  # type: ignore[arg-type]\n\n\n# ---------------------------------------------------------------- R05\n\ndef test_preview_returns_would_be_ids(env):\n    db, w = env\n    db.insert({'x': 1})\n    assert w.preview([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert w.preview([\n        {'op': 'insert', 'document': {'x': 2}},\n        {'op': 'remove', 'doc_id': 1},\n        {'op': 'insert', 'document': {'x': 3}},\n    ]) == [2, 3]\n\n\ndef test_preview_leaves_data_unchanged(env):\n    db, w = env\n    db.insert({'x': 1})\n    w.preview([{'op': 'insert', 'document': {'x': 2}},\n               {'op': 'remove', 'doc_id': 1}])\n    assert [d['x'] for d in db.all()] == [1]\n    assert len(db) == 1\n\n\ndef test_preview_does_not_consume_ids(env):\n"}