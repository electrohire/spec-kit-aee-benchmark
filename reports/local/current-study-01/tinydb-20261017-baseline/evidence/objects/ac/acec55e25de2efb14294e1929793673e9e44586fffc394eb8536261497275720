'document': {'x': 2}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    assert [d['x'] for d in table.all()] == [1]\n    assert len(table) == 1\n\n\ndef test_stale_query_cache_cleared_on_rollback(env):\n    db, w = env\n    db.insert({'x': 1})\n    table = db.table('_default')\n    q = where(\"x\") == 1\n    assert table.search(q) == [table.get(doc_id=1)]\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    # The cached result must not contain the rolled-back insert\n    assert [d.doc_id for d in table.search(q)] == [1]\n\n\ndef test_other_tables_unaffected_by_rollback(env):\n    db, w = env\n    other = db.table('other')\n    other.insert({'y': 1})\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 1}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    assert [d['y'] for d in other.all()] == [1]\n    assert len(db) == 0\n\n\ndef test_id_sequence_restored_after_rollback(env):\n    db, w = env\n    db.insert({'x': 1})\n    db.insert({'x': 2})\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'x': 3}},\n            {'op': 'remove', 'doc_id': 99},\n        ])\n    # The failed batch must not have consumed the next ID\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n\n\n# ---------------------------------------------------------------- R03\n\ndef test_ordinary_api_still_works(env):\n    db, w = env\n    assert db.insert({'x': 1}) == 1\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert db.insert({'x': 3}) == 3\n    assert [d['x'] for d in db.all()] == [1, 2, 3]\n    db.remove(where(\"x\") == 2)\n    assert [d['x'] for d in db.all()] == [1, 3]\n    assert len(db) == 2\n    assert db.search(where(\"x\") == 3)[0].doc_id == 3\n\n\ndef test_no_aliasing_of_input(env):\n    db, w = env\n    doc = {'x': 1, 'nested': {'a': [1, 2]}}\n    w.apply([{'op': 'insert', 'document': doc}])\n    # Mutating the caller's input after apply must not affect the DB\n    doc['x'] = 999\n    doc['nested']['a'].append(3)\n    stored = db.get(doc_id=1)\n    assert stored['x'] == 1\n    assert stored['nested']['a'] == [1, 2]\n\n\ndef test_no_aliasing_of_stored_data(env):\n    db, w = env\n    doc = {'x': 1, 'nested': {'a': [1, 2]}}\n    w.apply([{'op': 'insert', 'document': doc}])\n    # Mutating the stored document must not affect the caller's input\n    stored = db.get(doc_id=1)\n    stored['nested']['a'].append(3)\n    assert doc['nested']['a'] == [1, 2]\n\n\ndef test_input_not_moved_into_db(env):\n    db, w = env\n    doc = {'x': 1}\n    w.apply([{'op': 'insert', 'document': doc}])\n    stored = db.get(doc_id=1)\n    assert stored is not doc\n    assert stored['x'] == 1\n\n\ndef test_preexisting_documents_survive_batches(env):\n    db, w = env\n    db.insert({'x': 1})\n    db.insert({'x': 2})\n    w.apply([{'op': 'insert', 'document': {'x': 3}}])\n    w.apply([{'op': 'remove', 'doc_id': 1}])\n    assert [d['x'] for d in db.all()] == [2, 3]\n\n\n# ---------------------------------------------------------------- R04\n\ndef test_bool_doc_id_rejected(env):\n    db, w = env\n    for bad in (True, False):\n        with pytest.raises(ValueError):\n            w.apply([{'op': 'remove', 'doc_id': bad}])\n        with pytest.raises(ValueError):\n            w.preview([{'op': 'remove', 'doc_id': bad}])\n    assert len(db) == 0\n\n\ndef test_preview_bool_doc_id_rejected(env):\n    db, w = env\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'remove', 'doc_id': True}])\n    assert len(db) == 1\n\n\n@pytest.mark.parametrize('bad', [\n    {'op': 'insert', 'document': {}},          # empty dict IS accepted\n])\ndef test_empty_document_accepted(env, bad):\n    db, w = env\n    assert w.apply([bad]) == [1]\n    assert w.preview([{'op': 'insert', 'document': {}}]) == [2]\n\n\n@pytest.mark.parametrize('bad', [\n    {'op': 'insert', 'document': [1]},         # non-dict document\n    {'op': 'insert', 'document': 'x'},         # non-dict document\n    {'op': 'insert', 'document': 42},          # non-dict document\n    'not-a-dict',                              # non-dict operation\n    None,                                      # non-dict operation\n    {'op': 'insert'},                          # missing document\n    {'op': 'remove'},                          # missing doc_id\n    {'op': 'nope', 'doc_id': 1},               # unknown op\n])\ndef test_structural_validation_before_commit(env, bad):\n    db, w = env\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 2}}, bad])\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'insert', 'document': {'x': 2}}, bad])\n    # Nothing committed\n    assert [d['x'] for d in db.all()] == [1]\n    # And no ID consumed\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [2]\n\n\ndef test_non_list_operations_rejected(env):\n    db, w = env\n    for bad in ({'op': 'insert', 'document': {}}, ('op',), 'insert', 42):\n        with pytest.raises(ValueError):\n            w.apply(bad)  # type: ignore[arg-type]\n        with pytest.raises(ValueError):\n            w.preview(bad)  # type: ignore[arg-type]\n\n\n# ---------------------------------------------------------------- R05\n\ndef test_preview_returns_would_be_ids(env):\n    db, w = env\n    db.insert({'x': 1})\n    assert w.preview([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert w.preview([\n        {'op': 'insert', 'document': {'x': 2}},\n        {'op': 'remove', 'doc_id': 1},\n        {'op': 'insert', 'document': {'x': 3}},\n    ]) == [2, 3]\n\n\ndef test_preview_leaves_data_unchanged(env):\n    db, w = env\n    db.insert({'x': 1})\n    w.preview([{'op': 'insert', 'document': {'x': 2}},\n               {'op': 'remove', 'doc_id': 1}])\n    assert [d['x'] for d in db.all()] == [1]\n    assert len(db) == 1\n\n\ndef test_preview_does_not_consume_ids(env):\n    db, w = env\n    db.insert({'x': 1})\n    w.preview([{'op': 'insert', 'document': {'x': 2}},\n               {'op': 'insert', 'document': {'x': 3}}])\n    # The next real insert must still get ID 2\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    # Direct inserts also continue the sequence\n    assert db.insert({'x': 9}) == 3\n    assert w.preview([{'op': 'insert', 'document': {'x': 4}}]) == [4]\n\n\ndef test_preview_on_error_consumes_nothing(env):\n    db, w = env\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'insert', 'document': {'x': 2}},\n                   {'op': 'remove', 'doc_id': 99}])\n    assert [d['x'] for d in db.all()] == [1]\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert db.insert({'x': 9}) == 3\n\n\ndef test_preview_error_missing_remove(env):\n    db, w = env\n    with pytest.raises(ValueError):\n        w.preview([{'op': 'remove', 'doc_id': 1}])\n    assert len(db) == 0\n\n\ndef test_preview_same_batch_insert_then_remove(env):\n    db, w = env\n    # preview can remove an ID that the same batch inserts\n    assert w.preview([\n        {'op': 'insert', 'document': {'x': 1}},\n        {'op': 'remove', 'doc_id': 1},\n    ]) == [1]\n    assert len(db) == 0\n\n\ndef test_preview_empty(env):\n    db, w = env\n    assert w.preview([]) == []\n    assert w.preview([{'op': 'remove', 'doc_id': 1}]) == [] if False else True\n    # (remove-only batches return [])\n    db.insert({'x': 1})\n    assert w.preview([{'op': 'remove', 'doc_id': 1}]) == []\n\n\ndef test_preview_returns_fresh_detached_list(env):\n    db, w = env\n    first = w.preview([{'op': 'insert', 'document': {'x': 1}}])\n    assert first == [1]\n    # Mutating the returned list must not affect anything\n    first.append(999)\n    first[0] = -1\n    second = w.preview([{'op': 'insert', 'document': {'x': 1}}])\n    assert second == [1]\n    assert second is not first\n    # And the next real insert still gets ID 1\n    assert w.apply([{'op': 'insert', 'document': {'x': 1}}]) == [1]\n\n\ndef test_preview_does_not_touch_query_cache(env):\n    db, w = env\n    db.insert({'x': 1})\n    table = db.table('_default')\n    q = where('x') == 1\n    cached_before = table.search(q)\n    w.preview([{'op': 'insert', 'document': {'x': 1}}])\n    # Cached results must be unchanged and still coherent\n    assert table.search(q) == cached_before\n    assert [d.doc_id for d in table.search(q)] == [1]\n    assert len(table._query_cache) == len({'q': 1})  # one cached query\n\n\ndef test_preview_does_not_touch_table_handles(env):\n    db, w = env\n    db.insert({'x': 1})\n    table = db.table('_default')\n    before = [dict(d) for d in table.all()]\n    w.preview([{'op': 'insert', 'document': {'x': 2}},\n               {'op': 'remove', 'doc_id': 1}])\n    assert [dict(d) for d in table.all()] == before\n\n\n# ---------------------------------------------------------------- R06\n\ndef test_direct_inserts_seen_by_wrapper(env):\n    db, w = env\n    assert db.insert({'x': 1}) == 1\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert db.insert({'x': 3}) == 3\n    assert w.apply([{'op': 'insert', 'document': {'x': 4}}]) == [4]\n    assert [d['x'] for d in db.all()] == [1, 2, 3, 4]\n    assert w.preview([{'op': 'insert', 'document': {'x': 5}}]) == [5]\n\n\ndef test_no_stale_snapshot_between_calls(env):\n    db, w = env\n    w.apply([{'op': 'insert', 'document': {'x': 1}}])\n    db.insert({'x': 2})\n    db.insert({'x': 3})\n    # A failing batch must roll back to the *current* state, not an\n    # initial snapshot\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 4}},\n                 {'op': 'remove', 'doc_id': 99}])\n    assert [d['x'] for d in db.all()] == [1, 2, 3]\n    # And the next insert continues the sequence\n    assert w.apply([{'op': 'insert', 'document': {'x': 4}}]) == [4]\n\n\ndef test_preview_sees_direct_inserts(env):\n    db, w = env\n    db.insert({'x': 1})\n    w.preview([{'op': 'insert', 'document': {'x': 2}}])\n    db.insert({'x': 3})\n    # preview must reflect the direct insert: next ID is 3\n    assert w.preview([{'op': 'insert', 'document': {'x': 4}}]) == [3]\n\n\n# ------------------------------------------- R05 clarification (IDs)\n\ndef test_apply_advances_id_state_persisted(env):\n    db, w = env\n    assert w.apply([{'op': 'insert', 'document': {'x': 1}}]) == [1]\n    # direct db.insert continues the sequence (no reuse/rewind)\n    assert db.insert({'x': 2}) == 2\n    # another apply continues\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n\n\ndef test_ids_continue_across_removes(env):\n    db, w = env\n    assert w.apply([{'op': 'insert', 'document': {'x': 1}}]) == [1]\n    assert w.apply([{'op': 'insert', 'document': {'x': 2}}]) == [2]\n    assert w.apply([{'op': 'remove', 'doc_id': 1}]) == []\n    # removing doc 1 must not make ID 1 reusable\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n    assert db.insert({'x': 4}) == 4\n\n\ndef test_ids_continue_across_mixed_batch(env):\n    db, w = env\n    assert w.apply([\n        {'op': 'insert', 'document': {'x': 1}},\n        {'op': 'insert', 'document': {'x': 2}},\n        {'op': 'remove', 'doc_id': 1},\n        {'op': 'insert', 'document': {'x': 3}},\n    ]) == [1, 2, 3]\n    assert db.insert({'x': 4}) == 4\n\n\ndef test_failed_apply_does_not_consume_ids(env):\n    db, w = env\n    assert w.apply([{'op': 'insert', 'document': {'x': 1}}]) == [1]\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 2}},\n                 {'op': 'remove', 'doc_id': 99}])\n    # IDs 2 was not consumed by the failed batch\n    assert db.insert({'x': 2}) == 2\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n\n\ndef test_preview_matches_next_id_after_gaps(env):\n    db, w = env\n    db.insert({'x': 1})\n    db.insert({'x': 2})\n    db.remove(where('x') == 1)\n    # The next ID continues from the high-water mark, not from a gap\n    assert w.preview([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n    assert w.apply([{'op': 'insert', 'document': {'x': 3}}]) == [3]\n    assert db.insert({'x': 4}) == 4\n"}