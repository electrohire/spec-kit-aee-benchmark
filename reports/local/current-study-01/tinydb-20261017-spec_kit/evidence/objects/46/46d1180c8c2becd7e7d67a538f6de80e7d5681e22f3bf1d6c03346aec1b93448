ABCMeta as metaclass allows instantiating only storages that have\n    # implemented read and write\n\n    @abstractmethod\n    def read(self) -> Optional[dict[str, dict[str, Any]]]:\n        \"\"\"\n        Read the current state.\n\n        Any kind of deserialization should go here.\n\n        Return ``None`` here to indicate that the storage is empty.\n        \"\"\"\n\n        raise NotImplementedError('To be overridden!')\n\n    @abstractmethod\n    def write(self, data: dict[str, dict[str, Any]]) -> None:\n        \"\"\"\n        Write the current state of the database to the storage.\n\n        Any kind of serialization should go here.\n\n        :param data: The current state of the database.\n        \"\"\"\n\n        raise NotImplementedError('To be overridden!')\n\n    def close(self) -> None:\n        \"\"\"\n        Optional: Close open file handles, etc.\n        \"\"\"\n\n        pass\n\n\nclass JSONStorage(Storage):\n    \"\"\"\n=== utils LRUCache ===\n43:class LRUCache(abc.MutableMapping, Generic[K, V]):\n44-    \"\"\"\n45-    A least-recently used (LRU) cache with a fixed cache size.\n46-\n47-    This class acts as a dictionary but has a limited size. If the number of\n48-    entries in the cache exceeds the cache size, the least-recently accessed\n49-    entry will be discarded.\n50-\n51-    This is implemented using an ``OrderedDict``. On every access the accessed\n52-    entry is moved to the front by re-inserting it into the ``OrderedDict``.\n53-    When adding an entry and the cache size is exceeded, the last entry will\n54-    be discarded.\n55-    \"\"\"\n56-\n57-    def __init__(self, capacity=None) -> None:\n58-        self.capacity = capacity\n59-        self.cache: OrderedDict[K, V] = OrderedDict()\n60-\n61-    @property\n62-    def lru(self) -> list[K]:\n63-        return list(self.cache.keys())\n64-\n65-    @property\n66-    def length(self) -> int:\n67-        return len(self.cache)\n68-\n69-    def clear(self) -> None:\n70-        s