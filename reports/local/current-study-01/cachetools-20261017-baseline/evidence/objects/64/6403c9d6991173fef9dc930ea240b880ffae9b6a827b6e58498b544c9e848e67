 tag -> set(keys)`, `__key_tags: key -> set(tags)`.\n\n## Notes on superseded/conflicting evidence\n- Old design note 'empty all-tags matches every key' is SUPERSEDED by R04:\n  empty requested tags remove zero entries for both modes (tested).\n- Old note 'resizing may flush the cache' is SUPERSEDED by R05: resize only\n  evicts when shrinking below current size; growing is a no-op on entries\n  (tested).\n- Round-2 R05 clarification about preserving absolute expiry across resize\n  references R07/R08 (expiry not part of milestone 1/2 spec; no expiry state\n  exists in TaggedCache, so nothing to drop or recompute). Surviving entries\n  keep their exact stored value objects across resize (deep-copy on get).\n\n## Tests\n- tests/test_tagged.py: 97 tests (R01/R02/R02-ext/R03/R04/R05/R06 + edges).\n- acceptance_public.py: 2 passed. tests/ (upstream, unchanged): 217 passed.\n\nRun: `PYTHONPATH=src:. python -m pytest tests/ acceptance_public.py -q`\n=====\nimport pytest\nfrom cachetools.tagged import TaggedCache\n\ndef test_public_basic():\n    c = TaggedCache(2)\n    c.put('a', 1, ['x'])\n    assert c.get('a') == 1\n    assert c.invalidate('x') == 1 and len(c) == 0\n\ndef test_public_replacement():\n    c = TaggedCache(2)\n    c.put('a', 1, ['old'])\n    c.put('a', 2, ['new'])\n    assert c.invalidate('old') == 0 and c.get('a') == 2\n\ndef test_public_union_resize():\n    c = TaggedCache(3)\n    c.put('a', 1, ['x'])\n    c.put('b', 2, ['x', 'y'])\n    c.put('c', 3, ['y'])\n    assert c.invalidate_many(['x', 'y']) == 3\n    c.resize(1)\n    assert c.maxsize == 1\n\ndef test_public_ttl():\n    now = [0]\n    c = TaggedCache(2, timer=lambda: now[0])\n    c.put('a', 1, ttl=2)\n    now[0] = 3\n    with pytest.raises(KeyError):\n        c.get('a')\nimport pytest\nfrom cachetools.tagged import TaggedCache=====\n\"\"\"Tagged cache built on top of :class:`~cachetools.LRUCache`.\n\nProvides :class:`TaggedCache`, a bounded LRU cache whose entries carry a\nfinite set of string tags.  Entries can be looked up by key (returning a\ndetached deep copy) or removed in bulk by tag via :meth:`TaggedCache.invalidate`.\n\"\"\"\n\nimport collections\nimport copy\n\nfrom . import LRUCache\n\n_SENTINEL = object()\n\n\ndef _normalize_tags(tags):\n    \"\"\"Validate *tags* and return a tuple of the unique string tags.\n\n    Raises ``ValueError`` if *tags* is a bare string or contains a non-string\n    entry.  The iterable is fully consumed (and must be finite) before any\n    mutation of the cache is allowed to happen.\n    \"\"\"\n    if isinstance(tags, (str, bytes)):\n        raise ValueError(\"tags must be an iterable of strings, not %r\" % type(tags).__name__)\n    try:\n        iterator = iter(tags)\n    except TypeError:\n        raise ValueError(\"tags must be an iterable of strings, got %r\" % type(tags).__name__)\n    seen = set()\n    result = []\n    for tag in iterator:\n        if not isinstance(tag, str):\n            raise ValueError(\"tags must be an iterable of strings, got %r\" % (tag,))\n        if tag not in seen:\n            seen.add(tag)\n            result.append(tag)\n    return tuple(result)\n\n\nclass _TaggedLRUCache(LRUCache):\n    \"\"\"LRUCache that records evicted keys so tag memberships can be pruned.\"\"\"\n\n    def __init__(self, maxsize):\n        LRUCache.__init__(self, maxsize)\n        self._evicted = []\n\n    def popitem(self):\n        key, value = LRUCache.popitem(self)\n        self._evicted.append(key)\n        return (key, value)\n\n    def _resize(self, maxsize):\n        \"\"\"Change capacity, evicting least-recently-used entries if shrinking.\n\n        Growing never evicts.  Surviving entries keep their values, tags and\n        LRU order.  Evicted keys are appended to ``self._evicted``.\n\n        \"\"\"\n        if maxsize == self.maxsize:\n            return\n        self._evicted.clear()\n        self._Cache__maxsize = maxsize\n        while len(self) > maxsize:\n            key, value = LRUCache.popitem(self)\n            self._evicted.append(key)\n\n\nclass TaggedCache:\n    \"\"\"A bounded LRU cache with per-entry string tags.\n\n    Values are deep-copied on input and on retrieval, so callers can never\n    observe or mutate the stored state through a returned reference.  Each\n    value costs exactly one capacity slot regardless of its size.\n\n    \"\"\"\n\n    def __init__(self, maxsize):\n        if isinstance(maxsize, bool) or not isinstance(maxsize, int) or maxsize < 1:\n            raise ValueError(\"maxsize must be a positive integer, got %r\" % (maxsize,))\n        self.__maxsize = maxsize\n        self.__cache = _TaggedLRUCache(maxsize)\n        # tag -> set of keys currently carrying that tag\n        self.__tags = collections.defaultdict(set)\n        # key -> set of tags currently held by that key\n        self.__key_tags = {}\n\n    @property\n    def maxsize(self):\n        \"\"\"The maximum number of entries the cache can hold.\"\"\"\n        return self.__maxsize\n\n    def __len__(self):\n        \"\"\"Number of live entries currently cached.\"\"\"\n        return len(self.__cache)\n\n    def __contains__(self, key):\n        return key in self.__cache\n\n    def put(self, key, value, tags=()):\n        \"\"\"Insert or replace *key* with a deep copy of *value*.\n\n        *tags* must be a finite iterable of strings; a bare string is\n        rejected.  Duplicates are ignored.  If the key already exists, its\n        old tag memberships are replaced and its LRU recency is refreshed.\n\n        \"\"\"\n        # Validate and normalize tags before touching any state, so that an\n        # invalid replacement leaves the old value/tags/recency unchanged.\n        new_tags = _normalize_tags(tags)\n        cache = self.__cache\n        evicted = cache._evicted\n        if key in cache:\n            # drop old tag memberships before storing the new value\n            for tag in self.__key_tags.pop(key, ()):\n                self.__tags[tag].discard(key)\n            self.__prune_empty()\n            cache[key] = copy.deepcopy(value)\n        else:\n            if len(cache) == cache.maxsize:\n                # insertion will evict exactly the least-recently-used key\n                evicted.clear()\n                cache[key] = copy.deepcopy(value)\n                for old_key in evicted:\n                    self.__forget(old_key)\n            else:\n                cache[key] = copy.deepcopy(value)\n        self.__key_tags[key] = set(new_tags)\n        for tag in new_tags:\n            self.__tags[tag].add(key)\n\n    def __forget(self, key):\n        \"\"\"Drop all tag memberships of an evicted or removed *key*.\"\"\"\n        for tag in self.__key_tags.pop(key, ()):\n            self.__tags[tag].discard(key)\n        self.__prune_empty()\n\n    def __prune_empty(self):\n        for tag in list(self.__tags):\n            if not self.__tags[tag]:\n                del self.__tags[tag]\n\n    def get(self, key, default=_SENTINEL):\n        \"\"\"Return a detached deep copy of the value stored under *key*.\n\n        Raises ``KeyError`` if *key* is not cached.  A successful lookup\n        refreshes the entry's LRU recency.\n\n        \"\"\"\n        if key not in self.__cache:\n            if default is _SENTINEL:\n                raise KeyError(key)\n            return default\n        value = self.__cache[key]  # refreshes LRU recency\n        return copy.deepcopy(value)\n\n    def invalidate(self, tag):\n        \"\"\"Remove every currently cached entry carrying *tag*.\n\n        Returns the number of entries removed.  Unknown tags remove nothing\n        and return ``0``.\n\n        \"\"\"\n        keys = set(self.__tags.get(tag, ()))\n        if not keys:\n            return 0\n        for key in keys:\n            del self.__cache[key]\n            self.__forget(key)\n        return len(keys)\n\n    def invalidate_many(self, tags, mode=\"any\"):\n        \"\"\"Remove entries in bulk by tag.\n\n        ``mode='any'`` removes the union of entries carrying any of the\n        requested tags; ``mode='all'`` removes entries carrying every\n        requested tag.  An empty (or duplicate-free-collapsing) requested\n        tag set removes zero entries for either mode.  Returns the number\n        of distinct removed keys.  An invalid *mode* or *tags* raises\n        ``ValueError`` before any mutation.\n\n        \"\"\"\n        if mode not in (\"any\", \"all\"):\n            raise ValueError(\"mode must be 'any' or 'all', got %r\" % (mode,))\n        # validate and normalize before touching any state\n        requested = _normalize_tags(tags)\n        if not requested:\n            return 0\n        if mode == \"any\":\n            keys = set()\n            for tag in requested:\n                keys.update(self.__tags.get(tag, ()))\n        else:\n            keys = set(self.__tags.get(requested[0], ()))\n            for tag in requested[1:]:\n                keys.intersection_update(self.__tags.get(tag, ()))\n        if not keys:\n            return 0\n        for key in keys:\n            del self.__cache[key]\n            self.__forget(key)\n        return len(keys)\n\n    def resize(self, maxsize):\n        \"\"\"Change the cache capacity.\n\n        *maxsize* must be a positive integer (bool excluded), otherwise a\n        ``ValueError`` is raised and all state is left unchanged.  Shrinking\n        evicts the least-recently-used entries first; growing never evicts.\n        Surviving entries keep their values, tags and LRU order.\n\n        \"\"\"\n        if isinstance(maxsize, bool) or not isinstance(maxsize, int) or maxsize < 1:\n            raise ValueError(\"maxsize must be a positive integer, got %r\" % (maxsize,))\n        if maxsize == self.__maxsize:\n            return\n        evicted = self.__cache._evicted\n        self.__cache._resize(maxsize)\n        for old_key in evicted:\n            self.__forget(old_key)\n        self.__maxsize = maxsize\n\n    def pop(self, key, default=_SENTINEL):\n        \"\"\"Remove *key* and return a deep copy of its value.\"\"\"\n        if key not in self.__cache:\n            if default is _SENTINEL:\n                raise KeyError(key)\n            return default\n        value = self.__cache[key]\n        del self.__cache[key]\n        self.__forget(key)\n        return value\n\n    def clear(self):\n        \"\"\"Remove all entries and tag memberships.\"\"\"\n        self.__cache.clear()\n        self.__tags.clear()\n        self.__key_tags.clear()\n\n    def __repr__(self):\n        return \"%s(maxsize=%r, currsize=%r)\" % (\n            type(self).__name__,\n            self.__maxsize,\n            len(self.__cache),\n        )\n"}