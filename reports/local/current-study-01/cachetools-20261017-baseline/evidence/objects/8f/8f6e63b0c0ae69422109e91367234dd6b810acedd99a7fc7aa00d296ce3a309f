Cache(3)\n        c.put('a', {'k': [1]})\n        a1 = c.get('a')\n        a2 = c.get('a')\n        assert a1 is not a2\n        assert a1['k'] is not a2['k']\n\n    def test_tags_deduplicated(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ['x', 'x', 'y', 'y'])\n        assert c.invalidate('x') == 1\n        assert len(c) == 0\n\n    def test_bare_string_tags_rejected(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ['ok'])\n        with pytest.raises(ValueError):\n            c.put('b', 2, 'xy')\n        # state unchanged\n        assert 'b' not in c\n        assert c.get('a') == 1\n        assert c.invalidate('ok') == 1\n\n    def test_nonstring_tag_entry_rejected(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ['ok'])\n        with pytest.raises(ValueError):\n            c.put('b', 2, ['ok', 5])\n        assert 'b' not in c\n        assert c.get('a') == 1\n\n    def test_noniterable_tags_rejected(self):\n        c = TaggedCache(3)\n        with pytest.raises(ValueError):\n            c.put('a', 1, 42)\n        assert len(c) == 0\n\n    def test_generator_tags_accepted(self):\n        c = TaggedCache(3)\n        c.put('a', 1, (t for t in ['x', 'x', 'y']))\n        assert c.invalidate('y') == 1\n\n    def test_no_tags_default(self):\n        c = TaggedCache(3)\n        c.put('a', 1)\n        assert c.get('a') == 1\n        assert c.invalidate('whatever') == 0\n\n    def test_tuple_tags_accepted(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ('x', 'y'))\n        assert c.invalidate('x') == 1\n\n\nclass TestR02:\n    def test_invalidate_removes_exactly_tagged(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x', 'y'])\n        c.put('c', 3, ['y'])\n        c.put('d', 4)\n"}