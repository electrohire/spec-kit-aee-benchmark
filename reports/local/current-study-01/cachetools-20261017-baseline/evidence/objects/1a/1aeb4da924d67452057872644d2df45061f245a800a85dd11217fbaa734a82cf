{"command": "cat > /testbed/src/cachetools/tagged.py <<'PYEOF'\n\"\"\"Tagged cache built on top of :class:`~cachetools.LRUCache`.\n\nProvides :class:`TaggedCache`, a bounded LRU cache whose entries carry a\nfinite set of string tags and an optional absolute expiry.  Entries can be\nlooked up by key (returning a detached deep copy) or removed in bulk by tag\nvia :meth:`TaggedCache.invalidate` / :meth:`TaggedCache.invalidate_many`.\n\"\"\"\n\nimport collections\nimport copy\nimport math\nimport time\n\nfrom . import LRUCache\n\n_SENTINEL = object()\n\n\ndef _normalize_tags(tags):\n    \"\"\"Validate *tags* and return a tuple of the unique string tags.\n\n    Raises ``ValueError`` if *tags* is a bare string or contains a non-string\n    entry.  The iterable is fully consumed (and must be finite) before any\n    mutation of the cache is allowed to happen.\n\n    \"\"\"\n    if isinstance(tags, (str, bytes)):\n        raise ValueError(\n            \"tags must be an iterable of strings, not %r\" % type(tags).__name__\n        )\n    try:\n        iterator = iter(tags)\n    except TypeError:\n        raise ValueError(\n            \"tags must be an iterable of strings, got %r\" % type(tags).__name__\n        )\n    seen = set()\n    result = []\n    for tag in iterator:\n        if not isinstance(tag, str):\n            raise ValueError(\n                \"tags must be an iterable of strings, got %r\" % (tag,)\n            )\n        if tag not in seen:\n            seen.add(tag)\n            result.append(tag)\n    return tuple(result)\n\n\ndef _validate_ttl(ttl):\n    \"\"\"Validate *ttl* and return it unchanged.\n\n    ``None`` means no expiration.  Any other value must be a finite\n    nonnegative int or float (bool excluded); otherwise ``ValueError`` is\n    raised before any cache state is touched.\n\n    \"\"\"\n    if ttl is None:\n        return None\n    if isinstance(ttl, bool) or not isinstance(ttl, (int, float)):\n        raise ValueError(\"ttl must be None or a finite nonnegative number, got %r\" % (ttl,))\n    if math.isnan(ttl) or ttl < 0:\n        raise ValueError(\"ttl must be None or a finite nonnegative number, got %r\" % (ttl,))\n    return ttl\n\n\ndef _validate_maxsize(maxsize):\n    \"\"\"Validate *maxsize* and return it unchanged.\n\n    Must be a positive integer (bool excluded); otherwise ``ValueError``.\n\n    \"\"\"\n    if isinstance(maxsize, bool) or not isinstance(maxsize, int) or maxsize < 1:\n        raise ValueError(\"maxsize must be a positive integer, got %r\" % (maxsize,))\n    return maxsize\n\n\nclass _TaggedLRUCache(LRUCache):\n    \"\"\"LRUCache that records evicted keys so tag memberships can be pruned.\"\"\"\n\n    def __init__(self, maxsize):\n        LRUCache.__init__(self, maxsize)\n        self._evicted = []\n\n    def popitem(self):\n        key, value = LRUCache.popitem(self)\n        self._evicted.append(key)\n        return (key, value)\n\n    def _resize(self, maxsize):\n        \"\"\"Change capacity, evicting least-recently-used entries if shrinking.\n\n        Growing never evicts.  Surviving entries keep their values, tags,\n        LRU order and absolute expiries.  Evicted keys are appended to\n        ``self._evicted``.\n\n        \"\"\"\n        if maxsize == self.maxsize:\n            return\n        self._evicted.clear()\n        self._Cache__maxsize = maxsize\n        while len(self) > maxsize:\n            key, value = LRUCache.popitem(self)\n            self._evicted.append(key)\n\n\nclass TaggedCache:\n    \"\"\"A bounded LRU cache with per-entry string tags and optional TTLs.\n\n    Values are deep-copied on input and on retrieval, so callers can never\n    observe or mutate the stored state through a returned reference.  Each\n    value costs exactly one capacity slot regardless of its size.\n\n    :param maxsize: maximum number of entries; a positive integer (bool\n        excluded).\n    :param timer: callable returning the current time; defaults to\n        ``time