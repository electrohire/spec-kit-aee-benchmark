      self.__forget(key)\n\n    def get(self, key, default=_SENTINEL):\n        \"\"\"Return a detached deep copy of the value stored under *key*.\n\n        Raises ``KeyError`` if *key* is not cached or is expired.  A\n        successful lookup refreshes the entry's LRU recency.\n\n        \"\"\"\n        self.__purge_expired()\n        if key not in self.__cache:\n            if default is _SENTINEL:\n                raise KeyError(key)\n            return default\n        value = self.__cache[key]  # refreshes LRU recency\n        return copy.deepcopy(value)\n\n    def invalidate(self, tag):\n        \"\"\"Remove every currently cached live entry carrying *tag*.\n\n        Returns the number of entries removed.  Unknown tags remove nothing\n        and return ``0``.\n\n        \"\"\"\n        self.__purge_expired()\n        keys = set(self.__tags.get(tag, ()))\n        if not keys:\n            return 0\n        for key in keys:\n            del self.__cache[key]\n            self.__forget(key)\n        return len(keys)\n\n    def invalidate_many(self, tags, mode=\"any\"):\n        \"\"\"Remove entries in bulk by tag.\n\n        ``mode='any'`` removes the union of entries carrying any of the\n        requested tags; ``mode='all'`` removes entries carrying every\n        requested tag.  An empty requested tag set removes zero entries for\n        either mode.  Returns the number of distinct removed keys.  An\n        invalid *mode* or *tags* raises ``ValueError`` before any mutation.\n\n        \"\"\"\n        if mode not in (\"any\", \"all\"):\n            raise ValueError(\"mode must be 'any' or 'all', got %r\" % (mode,))\n        # validate and normalize before touching any state\n        requested = _normalize_tags(tags)\n        if not requested:\n            return 0\n        self.__purge_expired()\n        if mode == \"any\":\n            keys = set()\n            for tag in requested:\n                keys.update(self.__tags.get(tag, ()))\n        else:\n            keys = set(self.__tags.get(requested[0], ()))\n            for tag in requested[1:]:\n                keys.intersection_update(self.__tags.get(tag, ()))\n        if not keys:\n            return 0\n        for key in keys:\n            del self.__cache[key]\n            self.__forget(key)\n        return len(keys)\n\n    def resize(self, maxsize):\n        \"\"\"Change the cache capacity.\n\n        *maxsize* must be a positive integer (bool excluded), otherwise a\n        ``ValueError`` is raised and all state is left unchanged.  Expired\n        entries are removed first.  Shrinking evicts the\n        least-recently-used entries first; growing never evicts.\n        Surviving entries keep their values, tags, LRU order and absolute\n        expiries.\n\n        \"\"\"\n        _validate_maxsize(maxsize)\n        self.__purge_expired()\n        if maxsize == self.__maxsize:\n            return\n        evicted = self.__cache._evicted\n        self.__cache._resize(maxsize)\n        for old_key in evicted:\n            self.__forget(old_key)\n        self.__maxsize = maxsize\n\n    def pop(self, key, default=_SENTINEL):\n        \"\"\"Remove *key* and return a deep copy of its value.\"\"\"\n        self.__purge_expired()\n        if key not in self.__cache:\n            if default is _SENTINEL:\n                raise KeyError(key)\n            return default\n        value = self.__cache[key]\n        del self.__cache[key]\n        self.__forget(key)\n        return value\n\n    def clear(self):\n        \"\"\"Remove all entries and tag memberships.\"\"\"\n        self.__cache.clear()\n        self.__tags.clear()\n        self.__key_tags.clear()\n        self.__expiry.clear()\n\n    def __repr__(self):\n        return \"%s(maxsize=%r, currsize=%r)\" % (\n            type(self).__name__,\n            self.__maxsize,\n            len(self.__cache),\n        )\nPYEOF\necho written; python -c \"import ast; ast.parse(open('/testbed/src/cachetools/tagged.py').re