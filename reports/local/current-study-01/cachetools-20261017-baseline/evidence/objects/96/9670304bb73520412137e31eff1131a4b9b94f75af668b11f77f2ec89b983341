x', 'y']  # exactly one consumption pass\n        assert c.invalidate('y') == 1\n        assert len(c) == 0\n\n    def test_generator_tags_exhausted_after_put(self):\n        it = iter(['x', 'y'])\n        c = TaggedCache(5)\n        c.put('a', 1, it)\n        assert next(it, _STOP) is _STOP  # fully consumed\n        assert c.invalidate('x') == 1\n        assert c.invalidate('y') == 0\n\n    def test_detached_nested_across_repeated_gets(self):\n        c = TaggedCache(5)\n        c.put('a', {'d': {'n': [1, 2]}, 'l': [{'i': 3}]})\n        v1 = c.get('a')\n        v1['d']['n'].append(99)\n        v1['l'][0]['i'] = -1\n        v1['extra'] = True\n        v2 = c.get('a')\n        assert v2 == {'d': {'n': [1, 2]}, 'l': [{'i': 3}]}\n        assert v1 is not v2 and v1['d'] is not v2['d']\n        assert v1['d']['n'] is not v2['d']['n']\n\n    def test_detached_nested_across_puts(self):\n        c = TaggedCache(5)\n        v = {'d': [1, 2]}\n        c.put('a', v)\n        v['d'].append(3)  # mutate original after put\n        v1 = c.get('a')\n        assert v1 == {'d': [1, 2]}\n        v1['d'].append(4)\n        v2 = c.get('a')\n        assert v2 == {'d': [1, 2]}\n        # replace with a fresh nested value; old detached copies unaffected\n        c.put('a', {'d': [9]})\n        assert v2 == {'d': [1, 2]}\n        assert c.get('a') == {'d': [9]}\n\n    def test_deep_copy_not_shallow(self):\n        c = TaggedCache(5)\n        c.put('a', {'list': {'inner': {'deep': [0]}}})\n        out = c.get('a')\n        out['list']['inner']['deep'].append(1)\n        assert c.get('a') == {'list': {'inner': {'deep': [0]}}}\n\n\n_STOP = object()\n\n\nclass TestR04R05Edges:\n    def test_invalidate_many_all_first_tag_absent(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x', 'y'])\n        # first requested tag absent -> intersection empty, no mutation\n        assert c.invalidate_many(['z', 'x'], mode='all') == 0\n        assert len(c) == 2\n\n    def test_invalidate_many_invalid_mode_with_empty_tags(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        with pytest.raises(ValueError):\n            c.invalidate_many([], mode='none')\n        assert len(c) == 1 and c.get('a') == 1\n\n    def test_invalidate_many_invalid_tags_with_valid_mode(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        with pytest.raises(ValueError):\n            c.invalidate_many('xy', mode='all')\n        assert len(c) == 1 and c.get('a') == 1\n\n    def test_invalidate_many_does_not_refresh_recency(self):\n        c = TaggedCache(2)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['y'])\n        # invalidation of an unrelated tag must not change LRU order\n        assert c.invalidate_many(['z'], mode='any') == 0\n        c.put('c', 3)  # evicts LRU 'a'\n        assert 'a' not in c\n        assert c.get('b') == 2 and c.get('c') == 3\n\n    def test_resize_shrink_to_zero_entries(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ['x'])\n        c.resize(1)\n        assert len(c) == 1\n        c.resize(1)\n        assert len(c) == 1\n\n    def test_resize_shrink_all(self):\n        c = TaggedCache(3)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['y'])\n        c.resize(1)\n        assert len(c) == 1\n        assert c.get('b') == 2  # 'b' was MRU\n        assert 'a' not in c\n        assert c.invalidate('x') == 0\n        assert c.invalidate('y') == 1\n\n    def test_resize_grow_then_shrink_again(self):\n        c = TaggedCache(1)\n        c.put('a', 1)\n        c.resize(3)\n        c.put('b', 2)\n        c.put('c', 3)\n        c.resize(2)\n        assert len(c) == 2\n        assert 'a' not in c\n        assert c.get('b') == 2 and c.get('c') == 3\n\n    def test_resize_preserves_values_detached(self):\n        c = TaggedCache(3)\n        v = {'n': [1]}\n        c.put('a', v)\n        v['n'].append(2)  # stored copy unaffected\n        c.resize(2)\n        assert c.get('a') == {'n': [1]}\n\n    def test_invalidate_many_then_resize_consistent(self):\n        c = TaggedCache(4)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x'])\n        c.put('c', 3, ['y'])\n        c.put('d', 4, ['y'])\n        assert c.invalidate_many(['x'], mode='any') == 2\n        c.resize(1)\n        assert len(c) == 1\n        assert c.get('d') == 4  # MRU survivor\n        assert c.invalidate('y') == 1\n"}