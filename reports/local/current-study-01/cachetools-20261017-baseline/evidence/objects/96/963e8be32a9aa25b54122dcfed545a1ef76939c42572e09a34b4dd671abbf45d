nvalidate_many_any_union(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x', 'y'])\n        c.put('c', 3, ['y'])\n        c.put('d', 4, ['z'])\n        assert c.invalidate_many(['x', 'y'], mode='any') == 3\n        assert len(c) == 1\n        assert c.get('d') == 4\n\n    def test_invalidate_many_all_intersection(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x', 'y'])\n        c.put('c', 3, ['y'])\n        c.put('d', 4, ['x', 'y', 'z'])\n        assert c.invalidate_many(['x', 'y'], mode='all') == 2\n        assert len(c) == 2\n        assert c.get('a') == 1 and c.get('c') == 3\n\n    def test_invalidate_many_default_mode_any(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['y'])\n        assert c.invalidate_many(['x', 'y']) == 2\n        assert len(c) == 0\n\n    def test_invalidate_many_single_tag_matches_invalidate(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['x', 'y'])\n        assert c.invalidate_many(['x']) == 2\n        assert c.invalidate('y') == 0\n        assert len(c) == 0\n\n    def test_invalidate_many_empty_tags_remove_zero(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['y'])\n        assert c.invalidate_many([], mode='any') == 0\n        assert c.invalidate_many((), mode='all') == 0\n        assert c.invalidate_many(iter([]), mode='any') == 0\n        assert c.invalidate_many((t for t in []), mode='all') == 0\n        assert len(c) == 2\n        assert c.get('a') == 1 and c.get('b') == 2\n\n    def test_invalidate_many_dedup_all_mode(self):\n        c = TaggedCache(5)\n        c.put('a', 1, ['x'])\n        c.put('b', 2, ['y'])\n        # duplicates collapse; 'x','x' is just 'x'\n        assert c.invalidate_many(['x', 'x'], mode='all') == 1\n        assert len(c) == 1\n        assert c.get('b') == 2\n\n    def test_invalidate_many_distinct_keys(