 # evicts 'b'\n        assert 'b' not in c\n        assert c.get('a') == 1\n        assert c.get('c') == 3\n\n    def test_len_counts_live_entries(self):\n        c = TaggedCache(5)\n        assert len(c) == 0\n        c.put('a', 1)\n        c.put('b', 2)\n        assert len(c) == 2\n        c.invalidate('a') if 'a' in c else None\n        c.put('a', 1, ['t'])\n        c.invalidate('t')\n        assert len(c) == 1\n\n    def test_contains(self):\n        c = TaggedCache(2)\n        c.put('a', 1)\n        assert 'a' in c\n        assert 'b' not in c\n\n\nclass TestR02Extension:\n    def test_put_overwrite_refreshes_recency(self):\n        c = TaggedCache(2)\n        c.put('a', 1)\n        c.put('b', 2)\n        c.put('a', 10)  # overwrite makes 'a' MRU, 'b' LRU\n        c.put('c', 3)  # evicts 'b'\n        assert 'b' not in c\n        assert c.get('a') == 10\n        assert c.get('c') == 3\n\n    def test_put_overwrite_recency_vs_get(self):\n        c = TaggedCache(2)\n        c.put('a', 1)\n        c.put('b', 2)\n        c.put('a', 10)\n        c.put('d', 4)  # evicts 'b'\n        assert 'b' not in c and 'a' in c and 'd' in c\n\n\nclass TestR03:\n    def test_maxsize_positive_int_ok(self):\n        assert TaggedCache(1).maxsize == 1\n        assert TaggedCache(10).maxsize == 10\n\n    @pytest.mark.parametrize(\"bad\", [0, -1, -100, True, False, 1.5, \"2\", None, [1]])\n    def test_maxsize_invalid(self, bad):\n        with pytest.raises(ValueError):\n            TaggedCache(bad)\n\n    def test_invalid_replacement_leaves_state_unchanged(self):\n        c = TaggedCache(2)\n        c.put('a', 1, ['x'])\n        c.put('b', 2)  # 'b' is MRU now\n        with pytest.raises(ValueError):\n            c.put('a', 99, 'badtags')\n        assert c.get('a') == 1\n        assert c.invalidate('x') == 1  # old tag still there\n        assert len(c) == 1\n\n    def test_invalid_replacement_preserves_recency(self):\n        c = TaggedCache(2)\n        c.put('a', 1)\n        c.put('b