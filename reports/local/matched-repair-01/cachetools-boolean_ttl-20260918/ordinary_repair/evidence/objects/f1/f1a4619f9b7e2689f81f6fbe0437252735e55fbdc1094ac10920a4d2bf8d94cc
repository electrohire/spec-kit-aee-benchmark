{"command": "cd /testbed && PYTHONPATH=src:. python -c \"\nfrom cachetools.tagged import TaggedCache\n\n# Test R01: basic put/get with tags\nc = TaggedCache(2)\nc.put('a', 1, ['x'])\nassert c.get('a') == 1, 'basic get failed'\n\n# Test R01: deep copy\nc.put('b', {'nested': [1,2]}, ['y'])\nval = c.get('b')\nval['nested'].append(3)\nassert c.get('b') == {'nested': [1,2]}, 'deep copy failed'\n\n# Test R01: string rejected as tags\ntry:\n    c.put('k', 'v', 'tag')\n    assert False, 'should have raised'\nexcept ValueError:\n    pass\n\n# Test R01: non-string tag rejected\ntry:\n    c.put('k', 'v', [1])\n    assert False, 'should have raised'\nexcept ValueError:\n    pass\n\n# Test R02: invalidate\nc2 = TaggedCache(3)\nc2.put('a', 1, ['x'])\nc2.put('b', 2, ['x','y'])\nc2.put('c', 3, ['y'])\nassert c2.invalidate('x') == 2, f'expected 2, got {c2.invalidate(\"x\")}'\nassert len(c2) == 1\n\n# Test R02: replacement removes old tags\nc3 = TaggedCache(2)\nc3.put('a', 1, ['old'])\nc3.put('a', 2, ['new'])\nassert c3.invalidate('old') == 0\nassert c3.get('a') == 2\n\n# Test R03: maxsize validation\ntry:\n    TaggedCache(True)\n    assert False\nexcept ValueError:\n    pass\ntry:\n    TaggedCache(0)\n    assert False\nexcept ValueError:\n    pass\ntry:\n    TaggedCache(-1)\n    assert False\nexcept ValueError:\n    pass\n\n# Test R04: invalidate_many\ncc = TaggedCache(5)\ncc.put('a', 1, ['x'])\ncc.put('b', 2, ['x','y'])\ncc.put('c', 3, ['y','z'])\nassert cc.invalidate_many(['x','z']) == 3\nassert len(cc) == 0\n\n# mode='all'\ncc2 = TaggedCache(5)\ncc2.put('a', 1, ['x','y'])\ncc2.put('b', 2, ['x'])\ncc2.put('c', 3, ['y'])\nassert cc2.invalidate_many(['x','y'], mode='all') == 1\nassert len(cc2) == 2\n\n# Test R05: resize\ncc3 = TaggedCache(3)\ncc3.put('a', 1, ['x'])\ncc3.put('b', 2, ['x'])\ncc3.put('c', 3, ['x'])\ncc3.resize(2)\nassert len(cc3) == 2\nassert 'a' not in cc3  # LRU evicted\nassert cc3.maxsize == 2\n\n# Test R06: generator tags\ncc4 = TaggedCache(2)\ncc4.put('k', 'v', (t