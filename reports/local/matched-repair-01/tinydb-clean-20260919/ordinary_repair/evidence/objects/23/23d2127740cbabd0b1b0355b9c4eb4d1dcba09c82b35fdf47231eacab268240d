{"command": "cd /testbed && cat > tests/test_batch_writer.py << 'PYEOF'\nimport pytest\nfrom copy import deepcopy\nfrom tinydb import TinyDB\nfrom tinydb.storages import MemoryStorage\nfrom tinydb.journal import BatchWriter\n\n\n@pytest.fixture\ndef pair():\n    db = TinyDB(storage=MemoryStorage)\n    w = BatchWriter(db)\n    return (db, w)\n\n\n# R04: Reject bool as doc_id\ndef test_reject_bool_doc_id(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': True}])\n    assert len(db) == 1\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': False}])\n    assert len(db) == 1\n\n\n# R04: Reject non-dict documents (but accept valid dicts including empty ones)\n@pytest.mark.parametrize(\"bad_doc\", [1, \"string\", None, [1,2]])\ndef test_reject_non_dict_document(pair, bad_doc):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': bad_doc}])\n    assert len(db) == 0\n\n\n# R04: Accept empty dictionaries as documents\ndef test_accept_empty_dict_document(pair):\n    db, w = pair\n    result = w.apply([{'op': 'insert', 'document': {}}])\n    assert result == [1]\n    assert db.all() == [{}]\n\n\n# R04: Accept dict documents\ndef test_accept_dict_document(pair):\n    db, w = pair\n    result = w.apply([{'op': 'insert', 'document': {'a': 1}}])\n    assert result == [1]\n    assert db.all() == [{'a': 1}]\n\n\n# R04: Reject operations that are not dicts\ndef test_reject_non_dict_operation(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply(['not a dict'])\n    assert len(db) == 0\n\n\n# R04: Reject operations with unsupported fields\ndef test_reject_unsupported_fields(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 1}, 'extra': 'field'}])\n    assert len(db) == 0\n\n\n# R04: Reject non-list operations\ndef test_reject_non_list_operations(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply('not a list')\n    assert len(db) == 0\n\n\n# R04: Reject remove with unsupported fields\ndef test_reject_remove_extra_fields(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 1, 'extra': 'field'}])\n    assert len(db) == 1\n\n\n# R05: Preview doesn't consume IDs\ndef test_preview_no_id_consumption(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    assert w.preview(ops) == [1]\n    assert len(db) == 0  # No actual insert\n    assert w.preview(ops) == [1]  # Still returns [1]\n    # After apply, IDs should be 1 (not 2)\n    assert w.apply(ops) == [1]\n    assert db.all() == [{'x': 1}]\n\n\n# R05: Preview on errors doesn't consume IDs\ndef test_preview_error_no_id_consumption(pair):\n    db, w = pair\n    ops = [\n        {'op': 'insert', 'document': {'x': 1}},\n        {'op': 'remove', 'doc_id': 99}  # This will fail\n    ]\n    with pytest.raises(ValueError):\n        w.preview(ops)\n    assert len(db) == 0\n    # Still can preview and apply successfully\n    assert w.preview([{'op': 'insert', 'document': {'y': 2}}]) == [1]\n    assert w.apply([{'op': 'insert', 'document': {'y': 2}}]) == [1]\n\n\n# R06: Direct db.insert between wrapper calls is seen\ndef test_direct_insert_seen(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    result = w.apply([{'op': 'insert', 'document': {'y': 2}}])\n    assert result == [2]  # Should skip ID 1 used by direct insert\n    assert len(db) == 2\n\n\n# R06: Direct insert affects next_id after wrapper apply\ndef test_direct_insert_affects_next_id(pair):\n    db, w = pair\n    db.insert({'a': 1})\n    db.insert({'b': 2})\n    result = w.apply([{'op': 'insert', 'document': {'c': 3}}])\n    assert result == [3]  # Should be 3, not 1\n\n\n# R07: Idempotent token - same batch returns same IDs\ndef test_idempotent_token_same_batch(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    r1 = w.apply(ops, token='tok1')\n    r2 = w.apply(ops, token='tok1')\n    assert r1 == r2 == [1]\n    assert len(db) == 1  # Only one insert happened\n\n\n# R07: Token with different operations raises ValueError\ndef test_token_different_ops_raises(pair):\n    db, w = pair\n    ops1 = [{'op': 'insert', 'document': {'x': 1}}]\n    ops2 = [{'op': 'insert', 'document': {'x': 2}}]\n    w.apply(ops1, token='tok1')\n    with pytest.raises(ValueError):\n        w.apply(ops2, token='tok1')\n    assert len(db) == 1\n    assert db.all()[0] == {'x': 1}\n\n\n# R07: Failed batch doesn't consume token\ndef test_failed_batch_no_token_consumed(pair):\n    db, w = pair\n    ops = [\n        {'op': 'insert', 'document': {'x': 1}},\n        {'op': 'remove', 'doc_id': 99}  # Will fail\n    ]\n    with pytest.raises(ValueError):\n        w.apply(ops, token='tok2')\n    assert len(db) == 0\n    # Token should not be consumed, can retry with valid ops\n    w.apply([{'op': 'insert', 'document': {'y': 2}}])\n    assert len(db) == 1\n\n\n# R07: Token validation\ndef test_token_validation(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    # Empty string should raise\n    with pytest.raises(ValueError):\n        w.apply(ops, token='')\n    # Non-string should raise\n    with pytest.raises(ValueError):\n        w.apply(ops, token=123)\n    # None is normal operation - should NOT raise\n    result = w.apply(ops, token=None)\n    assert result == [1]\n\n\n# R08: Return list doesn't expose internal token bookkeeping\ndef test_return_list_no_leak(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    r1 = w.apply(ops, token='tok3')\n    r2 = w.apply(ops, token='tok3')\n    assert r1 == r2 == [1]\n    # Mutating the returned list shouldn't affect future calls\n    r1.clear()\n    r3 = w.apply(ops, token='tok3')\n    assert r3 == [1]\n\n\n# R03: Inserted data doesn't alias caller's input\ndef test_no_aliasing(pair):\n    db, w = pair\n    doc = {'nested': {'a': 1}}\n    w.apply([{'op': 'insert', 'document': doc}])\n    doc['nested']['a'] = 999\n    stored = db.all()[0]\n    assert stored['nested']['a'] == 1  # Not mutated\n\n\n# R03: Empty operations returns []\ndef test_empty_operations(pair):\n    db, w = pair\n    assert w.apply([]) == []\n    assert w.preview([]) == []\n\n\n# R03: Remove targeting missing ID raises ValueError\ndef test_remove_missing_id(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 99}])\n    assert len(db) == 1\n\n\n# R04: Reject negative doc_id\ndef test_reject_negative_doc_id(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': -1}])\n    assert len(db) == 1\n\n\n# R04: Reject zero doc_id\ndef test_reject_zero_doc_id(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 0}])\n    assert len(db) == 1\n\n\n# R04: Reject float doc_id\ndef test_reject_float_doc_id(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': 1.0}])\n    assert len(db) == 1\n\n\n# R04: Reject insert with non-dict document type\ndef test_reject_list_document(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': [1, 2, 3]}])\n    assert len(db) == 0\n\n\n# R03: Atomic rollback on error\ndef test_rollback_on_error(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([\n            {'op': 'insert', 'document': {'y': 2}},\n            {'op': 'remove', 'doc_id': 99}  # missing\n        ])\n    # Original data preserved, no partial insert\n    assert len(db) == 1\n    assert db.all() == [{'x': 1}]\n\n\n# R03: Multiple inserts return correct IDs\ndef test_multiple_inserts(pair):\n    db, w = pair\n    result = w.apply([\n        {'op': 'insert', 'document': {'a': 1}},\n        {'op': 'insert', 'document': {'b': 2}},\n        {'op': 'insert', 'document': {'c': 3}},\n    ])\n    assert result == [1, 2, 3]\n    assert len(db) == 3\n\n\n# R03: Remove followed by insert\ndef test_remove_then_insert(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    w.apply([\n        {'op': 'remove', 'doc_id': 1},\n        {'op': 'insert', 'document': {'y': 2}},\n    ])\n    assert len(db) == 1\n    assert db.all() == [{'y': 2}]\n\n\n# R07: Token bookkeeping not in user documents\ndef test_token_not_in_documents(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    w.apply(ops, token='mytoken')\n    doc = db.all()[0]\n    assert 'token' not in doc\n    assert 'tokens' not in doc\n\n\n# R05: Preview never records/consumes a token\ndef test_preview_no_token_consumption(pair):\n    db, w = pair\n    ops = [{'op': 'insert', 'document': {'x': 1}}]\n    # Preview with token-like behavior (preview doesn't accept token)\n    preview_result = w.preview(ops)\n    assert preview_result == [1]\n    # Apply with token\n    result = w.apply(ops, token='preview_tok')\n    assert result == [1]\n    assert len(db) == 1\n    # Same token again should return cached result\n    result2 = w.apply(ops, token='preview_tok')\n    assert result2 == [1]\n    assert len(db) == 1  # No duplicate insert\n\n\n# R03: Unknown op raises ValueError\ndef test_unknown_op(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'unknown', 'document': {'x': 1}}])\n    assert len(db) == 0\n\n\n# R03: Missing op key raises ValueError\ndef test_missing_op_key(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'document': {'x': 1}}])\n    assert len(db) == 0\n\n\n# R03: Missing document key raises ValueError\ndef test_missing_document_key(pair):\n    db, w = pair\n