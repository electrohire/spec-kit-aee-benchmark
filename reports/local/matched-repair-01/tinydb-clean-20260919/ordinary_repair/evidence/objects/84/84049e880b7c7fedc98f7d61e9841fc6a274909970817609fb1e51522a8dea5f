{"command": "cd /testbed && cat > tests/test_batch_writer.py << 'PYEOF'\nimport pytest\nfrom copy import deepcopy\nfrom tinydb import TinyDB\nfrom tinydb.storages import MemoryStorage\nfrom tinydb.journal import BatchWriter\n\n\n@pytest.fixture\ndef pair():\n    db = TinyDB(storage=MemoryStorage)\n    w = BatchWriter(db)\n    return (db, w)\n\n\n# R04: Reject bool as doc_id\n@pytest.mark.parametrize(\"doc_id\", [True, False])\ndef test_reject_bool_doc_id(pair, doc_id):\n    db, w = pair\n    db.insert({'x': 1})\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'remove', 'doc_id': doc_id}])\n    # Original data preserved\n    assert len(db) == 1\n\n\n# R04: Reject non-dict documents\n@pytest.mark.parametrize(\"bad_doc\", [1, \"string\", None, [1,2], {\"a\": 1}])\ndef test_reject_non_dict_document(pair, bad_doc):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': bad_doc}])\n    assert len(db) == 0\n\n\n# R04: Accept empty dictionaries as documents\ndef test_accept_empty_dict_document(pair):\n    db, w = pair\n    result = w.apply([{'op': 'insert', 'document': {}}])\n    assert result == [1]\n    assert db.all() == [{}]\n\n\n# R04: Reject operations that are not dicts\ndef test_reject_non_dict_operation(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply(['not a dict'])\n    assert len(db) == 0\n\n\n# R04: Reject operations with unsupported fields\ndef test_reject_unsupported_fields(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply([{'op': 'insert', 'document': {'x': 1}, 'extra': 'field'}])\n    assert len(db) == 0\n\n\n# R04: Reject non-list operations\ndef test_reject_non_list_operations(pair):\n    db, w = pair\n    with pytest.raises(ValueError):\n        w.apply('not a list')\n    assert len(db) == 0\n\n\n# R04: Reject remove with unsupported fields\ndef test_reject_remove_extra_fields(pair):\n    db, w = pair\n    db.insert({'x': 1})\n    with p