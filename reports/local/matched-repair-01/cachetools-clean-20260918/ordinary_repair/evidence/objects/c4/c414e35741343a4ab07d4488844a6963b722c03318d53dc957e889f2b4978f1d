{"command": "cd /testbed && PYTHONPATH=src:. python -c '\nfrom cachetools.tagged import TaggedCache\n\n# R04: invalidate_many - correct expectations\nc6 = TaggedCache(4)\nc6.put(\"a\", 1, [\"x\"])\nc6.put(\"b\", 2, [\"x\",\"y\"])\nc6.put(\"c\", 3, [\"y\"])\nc6.put(\"d\", 4, [\"z\"])\n# mode=any: union of entries with x OR z => a(x), b(x), d(z) = 3\nremoved = c6.invalidate_many([\"x\",\"z\"], mode=\"any\")\nassert removed == 3, f\"Expected 3, got {removed}\"\nassert len(c6) == 1\nprint(\"PASS: invalidate_many any mode\")\n\n# mode=all: entries with BOTH x AND y => only a\nremoved2 = c6.invalidate_many([\"x\",\"y\"], mode=\"all\")\nassert removed2 == 0  # a already gone, b has x but not y\nprint(\"PASS: invalidate_many all mode (no match)\")\n\n# Fresh test for all mode\nc7 = TaggedCache(3)\nc7.put(\"a\", 1, [\"x\",\"y\"])\nc7.put(\"b\", 2, [\"x\"])\nc7.put(\"c\", 3, [\"y\"])\nremoved = c7.invalidate_many([\"x\",\"y\"], mode=\"all\")\nassert removed == 1, f\"Expected 1, got {removed}\"\nassert len(c7) == 2\nprint(\"PASS: invalidate_many all mode\")\n\n# Empty tags\nc8 = TaggedCache(3)\nc8.put(\"a\", 1, [\"x\"])\nassert c8.invalidate_many([]) == 0\nassert len(c8) == 1\nprint(\"PASS: empty tags removes zero\")\n\n# Invalid mode\nc9 = TaggedCache(3)\ntry:\n    c9.invalidate_many([\"x\"], mode=\"invalid\")\n    print(\"FAIL: invalid mode accepted\")\nexcept ValueError:\n    print(\"PASS: invalid mode rejected\")\n\n# R05: resize\nc10 = TaggedCache(3)\nc10.put(\"a\", 1, [\"x\"])\nc10.put(\"b\", 2, [\"y\"])\nc10.put(\"c\", 3, [\"z\"])\nc10.resize(2)\nassert c10.maxsize == 2\nassert len(c10) == 2\nprint(\"PASS: resize down\")\n\nc10.resize(5)\nassert c10.maxsize == 5\nassert len(c10) == 2\nprint(\"PASS: resize up\")\n\n# Invalid resize preserves state\ntry:\n    c10.resize(0)\nexcept ValueError:\n    pass\nassert c10.maxsize == 5\nassert len(c10) == 2\nprint(\"PASS: invalid resize preserves state\")\n\n# R06: Tags as generators\nc11 = TaggedCache(3)\nc11.put(\"a\", 1, tags=(