resize(2)\nprint(\"resize down: maxsize=\" + str(cc4.maxsize) + \", len=\" + str(len(cc4)))\ncc4.resize(5)\nprint(\"resize up: maxsize=\" + str(cc4.maxsize) + \", len=\" + str(len(cc4)))\n\n# Test R07: TTL\nnow = [0]\nc5 = TaggedCache(2, timer=lambda: now[0])\nc5.put(\"a\", 1, ttl=2)\nprint(\"Before expiry: c5.get(a)=\" + str(c5.get(\"a\")))\nnow[0] = 2\nprint(\"At expiry boundary: len(c5)=\" + str(len(c5)))\ntry:\n    c5.get(\"a\")\n    print(\"FAIL: should raise KeyError\")\nexcept KeyError:\n    print(\"PASS: expired key raises KeyError\")\n\n# TTL=0 is immediately expired\nc6 = TaggedCache(2, timer=lambda: 0)\nc6.put(\"a\", 1, ttl=0)\nprint(\"TTL=0: len(c6)=\" + str(len(c6)))\n\n# Test get refreshes LRU\nc7 = TaggedCache(2)\nc7.put(\"a\", 1)\nc7.put(\"b\", 2)\nc7.get(\"a\")\nc7.put(\"c\", 3)\nprint(\"LRU refresh: a=\" + str(c7.get(\"a\")) + \", c=\" + str(c7.get(\"c\")))\n\nprint(\"All manual tests passed!\")\n'\n", "exit_code": 0, "stderr": "", "stdout": "PASS: bare string rejected\nPASS: non-string tags rejected\nTags deduplicated: True\ninvalidate returns count: removed=2, len=1\nReplacement removes old tags: c.invalidate(old)=0\nNew tag works: c.get(a)=2\nunion mode: removed=2, len=1\nall mode: removed=1, len=2\nempty tags: removed=0, len=1\nresize down: maxsize=2, len=2\nresize up: maxsize=5, len=2\nBefore expiry: c5.get(a)=1\nAt expiry boundary: len(c5)=0\nPASS: expired key raises KeyError\nTTL=0: len(c6)=0\nLRU refresh: a=1, c=3\nAll manual tests passed!\n"}