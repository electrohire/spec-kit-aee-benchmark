{"command": "cd /testbed && PYTHONPATH=src:. python -c \"\nfrom cachetools.tagged import TaggedCache\nimport pickle\n\n# R01: Basic put/get with tags, deep copy, ValueError for bad tags\nc = TaggedCache(3)\nc.put('a', 1, ['x'])\nc.put('b', 2, ['y'])\nassert c.get('a') == 1\nassert c.get('b') == 2\n# Deep copy test\nval = [1, 2, 3]\nc.put('c', val, ['z'])\nval.append(4)\nassert c.get('c') == [1, 2, 3]\n# Nested deep copy\nnested = {'a': [1, 2]}\nc.put('d', nested, ['w'])\nnested['a'].append(3)\nassert c.get('d') == {'a': [1, 2]}\n# Bad tags\ntry:\n    c.put('e', 1, 'bad')\n    assert False, 'Should raise'\nexcept ValueError:\n    pass\ntry:\n    c.put('e', 1, ['good', 123])\n    assert False, 'Should raise'\nexcept ValueError:\n    pass\n# Dedup tags - ['x','x','y'] becomes {'x','y'}, invalidate 'x' removes 'f'\nc.put('f', 1, ['x', 'x', 'y'])\nassert c.invalidate('x') == 1  # removes f\nprint('R01 OK')\n\n# R02: invalidate returns count, LRU eviction\ncc = TaggedCache(2)\ncc.put('a', 1, ['t'])\ncc.put('b', 2, ['t'])\ncc.put('c', 3, ['t'])  # evicts 'a'\nassert cc.invalidate('t') == 2\nassert len(cc) == 0\n# Replacing key removes old tags\ncc2 = TaggedCache(2)\ncc2.put('a', 1, ['old'])\ncc2.put('a', 2, ['new'])\nassert cc2.invalidate('old') == 0\nassert cc2.get('a') == 2\nprint('R02 OK')\n\n# R03: maxsize validation\ntry:\n    TaggedCache(-1)\n    assert False\nexcept ValueError:\n    pass\ntry:\n    TaggedCache(0)\n    assert False\nexcept ValueError:\n    pass\ntry:\n    TaggedCache(True)\n    assert False\nexcept ValueError:\n    pass\ntry:\n    TaggedCache(1.5)\n    assert False\nexcept ValueError:\n    pass\nprint('R03 OK')\n\n# R04: invalidate_many\ncc3 = TaggedCache(5)\ncc3.put('a', 1, ['x'])\ncc3.put('b', 2, ['x', 'y'])\ncc3.put('c', 3, ['y'])\ncc3.put('d', 4, ['z'])\nassert cc3.invalidate_many(['x', 'y']) == 3  # union: a,b,c\nassert len(cc3) == 1\nassert cc3.get('d') == 4\n# mode='all'\ncc4 = TaggedCache(5)\ncc4.put('a', 1, ['x', 'y'])\ncc4.put('b', 2, ['x']