{"command": "cat -n /testbed/src/cachetools/tagged.py | head -90", "exit_code": 0, "stderr": "", "stdout": "     1\t\"\"\"TaggedCache - a tag-aware bounded cache built on LRUCache.\"\"\"\n     2\t\n     3\timport copy\n     4\tfrom collections.abc import Iterable\n     5\t\n     6\tfrom cachetools import LRUCache\n     7\t\n     8\t\n     9\tclass TaggedCache(LRUCache):\n    10\t    \"\"\"A cache that supports per-entry string tags for group-based invalidation.\n    11\t\n    12\t    Inherits from cachetools.LRUCache for bounded storage and LRU eviction.\n    13\t    Supports tagging entries, tag-based invalidation, and deep-copy semantics.\n    14\t    \"\"\"\n    15\t\n    16\t    def __init__(self, maxsize, getsizeof=None):\n    17\t        \"\"\"Create a TaggedCache with the given maxsize.\n    18\t\n    19\t        Args:\n    20\t            maxsize: Maximum number of entries. Must be a positive integer\n    21\t                     (bool is excluded).\n    22\t            getsizeof: Optional callable returning the size of a value.\n    23\t\n    24\t        Raises:\n    25\t            ValueError: If maxsize is not a positive integer or is a bool.\n    26\t        \"\"\"\n    27\t        if isinstance(maxsize, bool) or not isinstance(maxsize, int) or maxsize <= 0:\n    28\t            raise ValueError(\"maxsize must be a positive integer (not bool)\")\n    29\t        super().__init__(maxsize, getsizeof)\n    30\t        self._tags = {}  # tag -> set of keys\n    31\t\n    32\t    # ------------------------------------------------------------------ maxsize\n    33\t    @property\n    34\t    def maxsize(self):\n    35\t        \"\"\"The maximum size of the cache.\"\"\"\n    36\t        return super().maxsize\n    37\t\n    38\t    @maxsize.setter\n    39\t    def maxsize(self, value):\n    40\t        \"\"\"Set maxsize, validating it is a positive integer (not bool).\"\"\"\n    41\t        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n    42\t            raise ValueError(\"maxsize must be a positive integer (not bool)\")\n    43\t        # Cache uses name-mangled _Cache__maxsize\n    44\t        self._Cache__maxsize = value\n    45\t\n    46\t    # ------------------------------------------------------------------ put\n    47\t    def put(self, key, value, tags=()):\n    48\t        \"\"\"Insert or replace an entry with the given key, value, and tags.\n    49\t\n    50\t        Args:\n    51\t            key: Hashable key.\n    52\t            value: Value to cache (deep-copied on input).\n    53\t            tags: Iterable of string tags (deduplicated). Must not be a bare\n    54\t                  string and must not contain non-string entries.\n    55\t\n    56\t        Raises:\n    57\t            ValueError: If tags is a bare string or contains non-string entries.\n    58\t        \"\"\"\n    59\t        # --- validate tags BEFORE any state mutation ---\n    60\t        if isinstance(tags, str):\n    61\t            raise ValueError(\"tags must not be a bare string\")\n    62\t        if not isinstance(tags, Iterable):\n    63\t            raise ValueError(\"tags must be an iterable\")\n    64\t        tag_list = list(tags)\n    65\t        for t in tag_list:\n    66\t            if not isinstance(t, str):\n    67\t                raise ValueError(\"all tag entries must be strings\")\n    68\t        # deduplicate while preserving order\n    69\t        seen = set()\n    70\t        deduped = []\n    71\t        for t in tag_list:\n    72\t            if t not in seen:\n    73\t                seen.add(t)\n    74\t                deduped.append(t)\n    75\t\n    76\t        # --- remove old tag memberships if key already exists ---\n    77\t        if key in self:\n    78\t            self._remove_key_from_tags(key)\n    79\t\n    80\t        # --- deep-copy value and store ---\n    81\t        copied_value = copy.deepcopy(value)\n    82\t        super().__setitem__(key, copied_value)\n    83\t\n    84\t        # --- record new tag memberships ---\n    85\t        for t in deduped:\n    86\t            self._tags.setdefault(t, set()).add(key)\n    87\t\n    88\t    # ------------------------------------------------------------------ get\n    89\t    def get(self, key, default=None):\n    90\t        \"\"\"Return a deep copy of the value for *key*, or *default*.\n"}